if LAYER not in adata.layers:

    if COUNTS_LAYER not in adata.layers:
        raise ValueError(
            f"Need raw counts in adata.layers['{COUNTS_LAYER}'] to build {LAYER}."
        )

    counts = adata.layers[COUNTS_LAYER].copy()
    cell_sums = np.asarray(counts.sum(axis=1)).flatten()

    if np.any(cell_sums == 0):
        raise ValueError("Some cells have zero total counts. Cannot compute CP10K.")

    if issparse(counts):
        counts = counts.tocsr()
        cp10k = counts.multiply((10000 / cell_sums)[:, None]).tocsr()
        log1p_cp10k = cp10k.copy()
        log1p_cp10k.data = np.log1p(log1p_cp10k.data)
        adata.layers[LAYER] = log1p_cp10k.tocsr()
    else:
        cp10k = counts / cell_sums[:, None] * 10000
        adata.layers[LAYER] = np.log1p(cp10k)

else:
