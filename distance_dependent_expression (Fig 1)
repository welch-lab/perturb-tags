def safe_name(x):
    return re.sub(r"[^A-Za-z0-9_]+", "_", str(x))


def token_mask_for_guide(adata, guide, col=lab_col):
    query_tokens = {
        t.strip()
        for t in re.split(r"[;|]", str(guide))
        if t.strip()
    }

    labels = adata.obs[col].astype(str).fillna("")

    return labels.str.split(r"[;|]").apply(
        lambda xs: query_tokens.issubset({
            t.strip() for t in xs if t.strip()
        })
    ).to_numpy()


def build_groups(adata, guide, radius):
    pert_mask = token_mask_for_guide(adata, guide)

    if pert_mask.sum() < min_pert:
        return None

    seed_mask = ~pert_mask

    coords = np.asarray(adata.obsm[sp_key], float)[:, :2]

    pert_idx = np.where(pert_mask)[0]
    seed_idx = np.where(seed_mask)[0]

    nbrs = NearestNeighbors(radius=radius).fit(coords[pert_idx])

    neigh_lists = nbrs.radius_neighbors(
        coords[seed_idx],
        return_distance=False
    )

    is_near = np.array([len(nb) > 0 for nb in neigh_lists])

    near_idx = seed_idx[is_near]
    far_idx = seed_idx[~is_near]

    if near_idx.size < min_near or far_idx.size < min_far:
        return None

    return pert_idx, near_idx, far_idx


def de_all_genes(adata, idx_a, idx_b, label_a, label_b):
    sub = adata[np.r_[idx_a, idx_b]].copy()

    sub.obs["zone"] = pd.Categorical(
        [label_a] * len(idx_a) + [label_b] * len(idx_b),
        categories=[label_a, label_b]
    )

    sc.tl.rank_genes_groups(
        sub,
        groupby="zone",
        groups=[label_a],
        reference=label_b,
        method="wilcoxon",
        use_raw=False,
        n_genes=sub.shape[1],
        layer=LAYER
    )

    df = sc.get.rank_genes_groups_df(sub, group=label_a)

    df = df[
        ["names", "scores", "logfoldchanges", "pvals_adj"]
    ].dropna()

    return df


def get_layer_matrix(adata, idx, genes):
    X = adata[idx, genes].layers[LAYER]
    X = X.toarray() if hasattr(X, "toarray") else np.asarray(X)
    return np.asarray(X)


def group_mean_matrix(adata, near_idx, far_idx, genes):
    Xn = get_layer_matrix(adata, near_idx, genes)
    Xf = get_layer_matrix(adata, far_idx, genes)

    m_near = Xn.mean(axis=0, keepdims=True)
    m_far = Xf.mean(axis=0, keepdims=True)

    return np.vstack([m_near, m_far])


def dotplot_stats(adata, near_idx, far_idx, genes):
    Xn = get_layer_matrix(adata, near_idx, genes)
    Xf = get_layer_matrix(adata, far_idx, genes)

    mean_mat = np.vstack([
        Xn.mean(axis=0),
        Xf.mean(axis=0)
    ])

    pct_mat = np.vstack([
        (Xn > 0).mean(axis=0) * 100,
        (Xf > 0).mean(axis=0) * 100
    ])

    return mean_mat, pct_mat

def plot_mean_heatmap_publication(M, genes, guide, radius, combo_name):
