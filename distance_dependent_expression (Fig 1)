def token_mask_for_guide(adata, guide, col=lab_col):
    query_tokens = {
        t.strip()
        for t in re.split(r"[;|]", str(guide))
        if t.strip()
    }

    labels = adata.obs[col].astype(str).fillna("")

    return labels.str.split(r"[;|]").apply(
        lambda xs: query_tokens.issubset({
            t.strip() for t in xs if t.strip()
        })
    ).to_numpy()


def get_expression_vector(adata, cells, gene, layer=LAYER):
    X = adata[cells, gene].layers[layer]

    if hasattr(X, "toarray"):
        X = X.toarray()

    return np.asarray(X).flatten()


def get_distance_to_guide_cells(adata, guide):
    pert_mask = token_mask_for_guide(adata, guide)

    if pert_mask.sum() == 0:
        return None, None, None

    coords = np.asarray(adata.obsm[sp_key], float)[:, :2]

    pert_idx = np.where(pert_mask)[0]
    nonpert_idx = np.where(~pert_mask)[0]

    nbrs = NearestNeighbors(n_neighbors=1).fit(coords[pert_idx])

    dist, _ = nbrs.kneighbors(
        coords[nonpert_idx],
        return_distance=True
    )

    return pert_idx, nonpert_idx, dist.flatten()


def plot_lowess_single(
    adata,
    guide,
    gene,
    radius,
    lowess_frac=LOWESS_FRAC,
    max_scatter_cells=MAX_SCATTER_CELLS
):
    if gene not in adata.var_names:
        print(f"Skipping {guide} -> {gene}: gene not found in adata.var_names.")
        return

    pert_idx, nonpert_idx, dist = get_distance_to_guide_cells(
        adata=adata,
        guide=guide
    )

    if pert_idx is None:
        print(f"Skipping {guide} -> {gene}: no perturbed/source cells found.")
        return

    expr = get_expression_vector(
        adata=adata,
        cells=nonpert_idx,
        gene=gene,
        layer=LAYER
    )

    valid = np.isfinite(dist) & np.isfinite(expr)

    x = dist[valid]
    y = expr[valid]
    
    keep = x <= 300
    x = x[keep]
    y = y[keep]

    if len(x) < 10:
        print(f"Skipping {guide} -> {gene}: too few valid cells.")
        return

    order = np.argsort(x)
    x_sorted = x[order]
    y_sorted = y[order]

    lo = lowess(
        endog=y_sorted,
        exog=x_sorted,
        frac=lowess_frac,
        return_sorted=True
    )

    rng = np.random.default_rng(0)

    if len(x) > max_scatter_cells:
        scatter_idx = rng.choice(
            np.arange(len(x)),
            size=max_scatter_cells,
            replace=False
        )
    else:
        scatter_idx = np.arange(len(x))

    fig, ax = plt.subplots(figsize=(3.2, 2.6), dpi=300)

    scatter_handle = ax.scatter(
        x[scatter_idx],
        y[scatter_idx],
        s=4,
        alpha=0.18,
        color="0.45",
        edgecolor="none",
        rasterized=True,
        label="Receiver cells"
    )

    lowess_handle, = ax.plot(
        lo[:, 0],
        lo[:, 1],
        color="#D62728",
        linewidth=1.6,
        label="LOWESS"
    )

    radius_handle = ax.axvline(
        radius,
        color="black",
        linestyle="--",
        linewidth=0.9,
        label=f"Radius = {radius} μm"
    )

    ax.set_title(
        f"{guide}\n{gene}",
        fontsize=9,
        pad=6
    )

    ax.set_xlabel("Distance to nearest guide-positive cell (μm)", fontsize=8)
    ax.set_ylabel(f"{gene} log1p(CP10K)", fontsize=8)

    ax.grid(False)
    ax.minorticks_off()

    ax.tick_params(
        axis="both",
        labelsize=7,
        width=0.8,
        length=3
    )

    ax.spines["top"].set_visible(False)
    ax.spines["right"].set_visible(False)
    ax.spines["left"].set_linewidth(0.8)
    ax.spines["bottom"].set_linewidth(0.8)

    plt.tight_layout()

    fname = safe_name(f"{guide}_{gene}_radius_{radius}_LOWESS")

    if SAVE_FIGURES:
        fig.savefig(
            os.path.join(output_dir, f"{fname}.png"),
            dpi=600,
            bbox_inches="tight"
        )
        fig.savefig(
            os.path.join(output_dir, f"{fname}.pdf"),
            bbox_inches="tight"
        )

    if SHOW_FIGURES:
        plt.show()
    else:
        plt.close(fig)

    legend_fig, legend_ax = plt.subplots(figsize=(1.8, 0.55), dpi=300)
    legend_ax.axis("off")

    legend_ax.legend(
        handles=[scatter_handle, lowess_handle, radius_handle],
        labels=["Receiver cells", "LOWESS", f"Radius = {radius} μm"],
        frameon=False,
        fontsize=6.5,
        loc="center",
        ncol=3,
        handlelength=1.4,
        columnspacing=1.0
    )

    plt.tight_layout(pad=0)

    if SAVE_FIGURES:
        legend_fig.savefig(
            os.path.join(output_dir, f"{fname}_legend.png"),
            dpi=600,
            bbox_inches="tight",
            transparent=True
        )
        legend_fig.savefig(
            os.path.join(output_dir, f"{fname}_legend.pdf"),
            bbox_inches="tight",
            transparent=True
        )

    if SHOW_FIGURES:
        plt.show()
    else:
        plt.close(legend_fig)

    print(
        f"{guide} -> {gene}: "
        f"source cells={len(pert_idx)}, "
        f"receiver cells={len(nonpert_idx)}, "
        f"plotted cells={len(x)}"
    )

for test in selected_lowess_tests:
