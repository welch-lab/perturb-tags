    pert_idx, near_idx, far_idx = built

    print(
        f"[{guide} | radius={radius}] "
        f"pert={len(pert_idx)}, near={len(near_idx)}, far={len(far_idx)}"
    )

    df_near = de_all_genes(
        adata,
        pert_idx,
        near_idx,
        "perturbed",
        "near"
    )

    df_far = de_all_genes(
        adata,
        pert_idx,
        far_idx,
        "perturbed",
        "far"
    )

    top_near = df_near.sort_values("pvals_adj").head(topN_each)
    top_far = df_far.sort_values("pvals_adj").head(topN_each)

    inter = pd.merge(
        top_near.rename(
            columns={
                "logfoldchanges": "logFC_near",
                "pvals_adj": "padj_near"
            }
        )[["names", "logFC_near", "padj_near"]],

        top_far.rename(
            columns={
                "logfoldchanges": "logFC_far",
                "pvals_adj": "padj_far"
            }
        )[["names", "logFC_far", "padj_far"]],

        on="names",
        how="inner"
    ).dropna()

    if inter.empty:
        print(f"[{guide} | radius={radius}] no overlap among top {topN_each} genes.")
        continue

    inter["delta_abs"] = np.abs(inter["logFC_near"]) - np.abs(inter["logFC_far"])
    inter["abs_diff"] = np.abs(inter["logFC_near"] - inter["logFC_far"])

    inter = inter.sort_values("abs_diff", ascending=False)

    genes_plot = [
        g for g in inter["names"].tolist()
        if g in adata.var_names
    ][:plot_top]

    if not genes_plot:
        print(f"[{guide} | radius={radius}] no plottable genes.")
        continue

    combo_name = safe_name(f"{guide}_radius_{radius}")

    inter.to_csv(
        os.path.join(
            output_dir,
            f"{combo_name}_intersect_DE_genes.csv"
        ),
        index=False
    )

    M = group_mean_matrix(
        adata,
        near_idx,
        far_idx,
        genes_plot
    )

    mean_mat, pct_mat = dotplot_stats(
        adata,
        near_idx,
        far_idx,
        genes_plot
    )

    print(
        f"[{guide} | radius={radius}] heatmap range on {LAYER}: "
        f"{float(M.min()):.4f} .. {float(M.max()):.4f}"
    )

    plot_mean_heatmap_publication(
        M=M,
        genes=genes_plot,
        guide=guide,
        radius=radius,
        combo_name=combo_name
    )

    plot_dotplot_publication(
        mean_mat=mean_mat,
        pct_mat=pct_mat,
        genes=genes_plot,
        guide=guide,
        radius=radius,
        combo_name=combo_name
    )

    summary_rows.append({
        "guide": guide,
        "radius": radius,
        "n_pert": len(pert_idx),
        "n_near": len(near_idx),
        "n_far": len(far_idx),
        "intersect_count": len(inter),
        "shown_genes": len(genes_plot),
        "median_abs_diff_logFC": float(inter["abs_diff"].median()),
        "max_abs_diff_logFC": float(inter["abs_diff"].max()),
        "expression_layer": LAYER,
        "output_prefix": combo_name
    })

    print(
        f"[{guide} | radius={radius}] intersect count={len(inter)}; "
        f"shown={len(genes_plot)}; "
        f"median |ΔlogFC|={inter['abs_diff'].median():.3f}"
    )

summary_df = pd.DataFrame(summary_rows)

summary_df.to_csv(
    os.path.join(output_dir, "guide_specific_radius_analysis_summary.csv"),
    index=False
)

display(summary_df)



