def safe_name(x):
    return re.sub(r"[^A-Za-z0-9_]+", "_", str(x))


def split_tokens(s):
    """
    Split a guides string on ';' or '|' into clean guide tokens.
    """
    return [
        t.strip()
        for t in re.split(r"[;|]", str(s))
        if t.strip()
    ]


def token_mask_for_exact_combo(adata, guide_or_combo, col=lab_col):
    """
    Match one guide or one guide combo.

    Single guide:
        'NRP1-5'
        cell is positive if it contains NRP1-5.

    Guide combo:
        'ALB-2;NRP1-2;NRP1-5'
        cell is positive only if it contains ALL listed guide tokens.

    Multi-guide cells are allowed.
    """
    query_tokens = {
        t.strip()
        for t in re.split(r"[;|]", str(guide_or_combo))
        if t.strip()
    }

    labels = adata.obs[col].astype(str).fillna("")

    return labels.apply(
        lambda s: query_tokens.issubset(set(split_tokens(s)))
    ).to_numpy()

def get_expr_vector(adata, gene, layer=None):
    """
    Returns a 1D expression vector of length n_obs.
    """
    X = adata[:, gene].layers[layer] if layer is not None else adata[:, gene].X

    if hasattr(X, "toarray"):
        X = X.toarray()

    return np.ravel(X)


def compute_expr_for_all_cells(adata, gene, layer):
    """
    Returns raw log-normalized expression from selected layer.
    """
    return get_expr_vector(adata, gene, layer=layer)


def _scatter_area_pts2_for_diameter_um(ax, diam_um):
    """
    Convert a diameter in data units, here µm, to matplotlib scatter area.
    """
    fig = ax.figure

    p0 = ax.transData.transform((0, 0))
    p1 = ax.transData.transform((diam_um, 0))

    dx_pixels = abs(p1[0] - p0[0])
    dx_points = dx_pixels * 72.0 / fig.dpi

    area_pts2 = np.pi * (dx_points / 2.0) ** 2

    return area_pts2


def _legend_handle_for_cell_diameter(ax, diam_um, color="white"):
    """
    Create a legend handle matching plotted cell diameter.
    """
    area_pts2 = _scatter_area_pts2_for_diameter_um(ax, diam_um)
    diam_points = np.sqrt(area_pts2 / np.pi) * 2.0

    handle = Line2D(
        [0],
        [0],
        marker="o",
        linestyle="None",
        markersize=diam_points,
        markerfacecolor=color,
        markeredgecolor="k",
        markeredgewidth=0.8
    )

    return handle


def _add_micron_scalebar(
    ax,
    microns_per_unit=1.0,
    bar_microns=100.0,
    color="k",
    lw=3.0,
    pad_frac=0.03,
    text_offset_frac=0.012,
    fontsize=14
):
    """
    Draw a horizontal scale bar.
    """
    if microns_per_unit <= 0:
        return

    bar_length_units = bar_microns / microns_per_unit

    x0, x1 = ax.get_xlim()
    y0, y1 = ax.get_ylim()

    dx = x1 - x0
    dy = y1 - y0

    x_start = x0 + pad_frac * dx
    y_pos = y0 + pad_frac * dy
    x_end = x_start + bar_length_units

    ax.plot(
        [x_start, x_end],
        [y_pos, y_pos],
        color=color,
        lw=lw,
        solid_capstyle="butt",
        zorder=10
    )

    ax.text(
        (x_start + x_end) / 2.0,
        y_pos + text_offset_frac * dy,
        f"{bar_microns:.0f} µm",
        ha="center",
        va="bottom",
        color=color,
        fontsize=fontsize,
        zorder=10,
        bbox=dict(
            boxstyle="round,pad=0.25",
            fc="white",
            ec="none",
            alpha=0.8
        )
    )


def build_perturbed_cells(adata, guide_or_combo):
    """
    Return perturbed cell indices for one guide or guide combo.
    """
    pert_mask = token_mask_for_exact_combo(
        adata=adata,
        guide_or_combo=guide_or_combo,
        col=lab_col
    )

    if pert_mask.sum() < min_pert:
        return None

    pert_idx = np.where(pert_mask)[0]

    return pert_idx


def compute_near_far_counts(adata, pert_idx, radius):
    """
    Optional summary only:
    Counts non-perturbed receiver cells within radius vs outside radius.
    These are not plotted separately.
    """
    coords = np.asarray(adata.obsm[sp_key], float)[:, :2]

    pert_mask = np.zeros(adata.n_obs, dtype=bool)
    pert_mask[pert_idx] = True

    receiver_idx = np.where(~pert_mask)[0]

    nbrs = NearestNeighbors(radius=radius).fit(coords[pert_idx])

    neigh_lists = nbrs.radius_neighbors(
        coords[receiver_idx],
        return_distance=False
    )

    is_near = np.array([len(x) > 0 for x in neigh_lists])

    n_near = int(is_near.sum())
    n_far = int((~is_near).sum())

    return n_near, n_far



def plot_all_cells_expression_with_radius(
    adata,
    guide_or_combo,
    gene,
    radius,
    expr_vis,
    pert_idx,
    sp_key="spatial",
    cmap="viridis",
    figsize=(16, 10),
    out_png=None,
    dpi=300,
    show_pert=True,
    pert_color="red",
    pctl_range=(1, 99),
    draw_radius_circles=True
):
    """
    Plot ALL cells colored by gene expression.
    Overlay perturbed cells.
    Optionally draw radius circles around perturbed cells.
    Does NOT create NEAR or FAR maps.
    """

    coords = np.asarray(adata.obsm[sp_key], float)[:, :2]

    lo, hi = np.percentile(expr_vis, pctl_range)

    if np.isclose(lo, hi):
        pad = 1e-9
        lo, hi = lo - pad, hi + pad

    fig, ax = plt.subplots(1, 1, figsize=figsize, dpi=dpi)
    ax.grid(False)

    ax.set_xlim(np.min(coords[:, 0]), np.max(coords[:, 0]))
    ax.set_ylim(np.min(coords[:, 1]), np.max(coords[:, 1]))

    fig.canvas.draw()

    area_pts2 = _scatter_area_pts2_for_diameter_um(
        ax=ax,
        diam_um=CELL_DIAMETER_UM
    )

    # ALL cells colored by expression
    sc_plot = ax.scatter(
        coords[:, 0],
        coords[:, 1],
        c=expr_vis,
        cmap=cmap,
        s=area_pts2,
        alpha=0.95,
        edgecolor="none",
        vmin=lo,
        vmax=hi,
        zorder=1
    )

    # Radius circles around perturbed cells
    if draw_radius_circles and len(pert_idx) > 0:

        if len(pert_idx) > MAX_RADIUS_CIRCLES:
            circle_idx = pert_idx[:MAX_RADIUS_CIRCLES]
            print(
                f"[{guide_or_combo} | radius={radius} | {gene}] "
                f"Drawing only first {MAX_RADIUS_CIRCLES} radius circles "
                f"out of {len(pert_idx)} perturbed cells."
            )
        else:
            circle_idx = pert_idx

        for idx in circle_idx:
            circ = Circle(
                xy=(coords[idx, 0], coords[idx, 1]),
                radius=radius,
                fill=False,
                edgecolor=RADIUS_CIRCLE_COLOR,
                linewidth=RADIUS_CIRCLE_LINEWIDTH,
                alpha=RADIUS_CIRCLE_ALPHA,
                zorder=3
            )
            ax.add_patch(circ)

    # Perturbed cells overlay
    if show_pert and len(pert_idx) > 0:
        ax.scatter(
            coords[pert_idx, 0],
            coords[pert_idx, 1],
            s=area_pts2 * 5.0,
            c=pert_color,
            alpha=1.0,
            zorder=6,
            edgecolor="none"
        )

    ax.set_title(
        f"{guide_or_combo} — ALL cells — {gene}\n"
        f"radius = {radius} µm",
        fontsize=18,
        pad=10
    )

    ax.set_xlabel("X (µm)", fontsize=14)
    ax.set_ylabel("Y (µm)", fontsize=14)
    ax.tick_params(axis="both", labelsize=12)

    # Colorbar
    cax = fig.add_axes([0.91, 0.16, 0.02, 0.66])
    cbar = fig.colorbar(sc_plot, cax=cax)
    cbar.set_label(f"{gene} ({LAYER})", fontsize=12)

    # Legend
    cell_handle = _legend_handle_for_cell_diameter(
        ax=ax,
        diam_um=CELL_DIAMETER_UM,
        color="white"
    )

    pert_handle = Line2D(
        [0],
        [0],
        marker="o",
        linestyle="None",
        markersize=np.sqrt(area_pts2 / np.pi) * 2.0,
        markerfacecolor=pert_color,
        markeredgecolor="none"
    )

    radius_handle = Line2D(
        [0],
        [0],
        color=RADIUS_CIRCLE_COLOR,
        lw=2,
        alpha=0.6
    )

    legend_handles = [cell_handle, pert_handle]
    legend_labels = [
        f"Cell diameter ≈ {CELL_DIAMETER_UM:.2f} µm",
        "Perturbed cells"
    ]

    if draw_radius_circles:
        legend_handles.append(radius_handle)
        legend_labels.append(f"Radius = {radius} µm")

    ax.legend(
        legend_handles,
        legend_labels,
        loc="lower right",
        frameon=False,
        fontsize=12
    )

    # Scale bar
    _add_micron_scalebar(
        ax,
        microns_per_unit=MICRONS_PER_UNIT,
        bar_microns=SCALE_BAR_MICRONS,
        color=SCALE_BAR_COLOR,
        lw=3.0,
        fontsize=14
    )

    ax.set_aspect("equal", adjustable="box")

    plt.tight_layout(rect=[0, 0, 0.88, 1])

    if out_png is not None:
        fig.savefig(out_png, dpi=dpi, bbox_inches="tight")
        plt.close(fig)
    else:
        plt.show()



