    )

    ax.set_yticks([0, 1])
    ax.set_yticklabels(["Near", "Far"])

    ax.set_xticks(np.arange(len(genes)))
    ax.set_xticklabels(genes, rotation=90, ha="center", va="top")

    ax.set_title(
        f"{guide} | radius={radius} μm\nNear vs Far mean expression",
        pad=8
    )

    ax.set_ylabel("Receiver cells")
    ax.set_xlabel("Genes")

    ax.grid(False)
    ax.minorticks_off()

    ax.tick_params(axis="both", length=3, width=0.8)

    for spine in ax.spines.values():
        spine.set_linewidth(0.8)

    cbar = fig.colorbar(im, ax=ax, fraction=0.035, pad=0.025)
    cbar.set_label("Mean log1p(CP10K)", fontsize=8)
    cbar.ax.tick_params(labelsize=7, width=0.8, length=3)

    plt.tight_layout()

    if SAVE_FIGURES:
        fig.savefig(
            os.path.join(output_dir, f"{combo_name}_near_far_mean_heatmap_publishable.png"),
            dpi=600,
            bbox_inches="tight"
        )
        fig.savefig(
            os.path.join(output_dir, f"{combo_name}_near_far_mean_heatmap_publishable.pdf"),
            bbox_inches="tight"
        )

    if SHOW_FIGURES:
        plt.show()
    else:
        plt.close(fig)


def plot_dotplot_publication(mean_mat, pct_mat, genes, guide, radius, combo_name):
    groups = ["Near", "Far"]

    fig_width = max(6.8, 0.26 * len(genes))
    fig_height = 2.6

    fig = plt.figure(figsize=(fig_width, fig_height), dpi=300)

    ax = fig.add_axes([0.08, 0.28, 0.68, 0.52])
    cax = fig.add_axes([0.80, 0.28, 0.025, 0.52])
    lax = fig.add_axes([0.88, 0.28, 0.10, 0.52])
    lax.axis("off")

    x = np.arange(len(genes))
    y = np.arange(len(groups))

    xx, yy = np.meshgrid(x, y)

    sizes = 8 + pct_mat.flatten() * 1.5
    colors = mean_mat.flatten()

    sc_plot = ax.scatter(
        xx.flatten(),
        yy.flatten(),
        s=sizes,
        c=colors,
        cmap="viridis",
        edgecolor="black",
        linewidth=0.25
    )

    ax.set_yticks(y)
    ax.set_yticklabels(groups)

    ax.set_xticks(x)
    ax.set_xticklabels(genes, rotation=90, ha="center", va="top")

    ax.set_xlim(-0.5, len(genes) - 0.5)
    ax.set_ylim(len(groups) - 0.5, -0.5)

    ax.set_title(
        f"{guide} | radius={radius} μm\nMean expression and percent expressing",
        pad=8
    )

    ax.set_ylabel("Receiver cells")
    ax.set_xlabel("Genes", labelpad=8)

    ax.grid(False)
    ax.minorticks_off()

    ax.tick_params(axis="both", length=3, width=0.8)

    for spine in ax.spines.values():
        spine.set_linewidth(0.8)

    cbar = fig.colorbar(sc_plot, cax=cax)
    cbar.set_label("Mean log1p(CP10K)", fontsize=8, labelpad=8)
    cbar.ax.tick_params(labelsize=7, width=0.8, length=3)

    size_handles = []
    for pct in [25, 50, 75, 100]:
        size_handles.append(
            lax.scatter(
                [],
                [],
                s=8 + pct * 1.5,
                facecolor="white",
                edgecolor="black",
                linewidth=0.4,
                label=f"{pct}%"
            )
        )

    lax.legend(
        handles=size_handles,
        title="% expressing",
        frameon=False,
        loc="center left",
        fontsize=7,
        title_fontsize=8,
        borderaxespad=0,
