def dense32(x):
    return x.toarray().astype(np.float32) if sp.issparse(x) else np.asarray(x, dtype=np.float32)


def get_counts(adata):
    x = adata.layers[COUNTS_LAYER] if COUNTS_LAYER in adata.layers else adata.X
    return x.tocsr().astype(np.float32) if sp.issparse(x) else sp.csr_matrix(np.asarray(x, dtype=np.float32))


def parse_guides(v):
    if v is None or (isinstance(v, float) and np.isnan(v)): return []
    if isinstance(v, (list, tuple, np.ndarray)): vals = v
    else:
        s = str(v).strip()
        if s == "" or s.lower() in {"nan","none","unassigned","no guide","no_guide"}: return []
        vals = s.split(";")
    return [str(x).strip() for x in vals if str(x).strip()]


def build_guides(obs):
    if GUIDE_SOURCE_COL not in obs: raise KeyError(f"Missing obs[{GUIDE_SOURCE_COL!r}]")
    rows = [parse_guides(v) for v in obs[GUIDE_SOURCE_COL].astype(object).to_numpy()]
    names = sorted({g for row in rows for g in row})
    if not names: raise ValueError("No guides parsed")
    lookup = {g:i for i,g in enumerate(names)}
    X = np.zeros((len(rows), len(names)), np.float32)
    for i,row in enumerate(rows):
        for g in row: X[i, lookup[g]] = 1.0
    return X, names


def choose_split(labels):
    u = np.asarray(pd.unique(labels), dtype=object)
    if len(u) < 3: raise ValueError("Need at least 3 EBs")
    rng = np.random.default_rng(SPLIT_SEED); rng.shuffle(u)
    te = TEST_EB if TEST_EB is not None else u[0]
    va = VAL_EB if VAL_EB is not None else next(x for x in u if x != te)
    trm = (labels != te) & (labels != va); vam = labels == va; tem = labels == te
    return trm, vam, tem, va, te


def select_hvgs(counts_train, n):
    totals = np.asarray(counts_train.sum(1)).ravel()
    norm = counts_train.multiply((1e4 / np.maximum(totals, 1.0))[:,None]).tocsr(); norm.data = np.log1p(norm.data)
    m = np.asarray(norm.mean(0)).ravel(); v = np.asarray(norm.power(2).mean(0)).ravel() - m*m
    detected = np.asarray((counts_train > 0).sum(0)).ravel() >= 10; v[~detected] = -np.inf
    return np.sort(np.argsort(v)[-min(n, np.isfinite(v).sum()):]).astype(int)


def build_graph(coords, labels):
    ss=[]; dd=[]; ww=[]
    for eb in pd.unique(labels):
        idx=np.flatnonzero(labels==eb)
        if len(idx)<2: continue
        pairs=cKDTree(coords[idx,:2]).query_pairs(RADIUS, output_type='ndarray')
        if pairs.size==0: continue
        u,v=idx[pairs[:,0]],idx[pairs[:,1]]
        dist=np.linalg.norm(coords[u,:2]-coords[v,:2],axis=1).astype(np.float32)
        keep=dist>0; u,v,dist=u[keep],v[keep],dist[keep]
        ss.extend([u,v]); dd.extend([v,u]); ww.extend([dist,dist])
    if not ss: raise RuntimeError("No graph edges")
    return torch.tensor(np.vstack([np.concatenate(ss),np.concatenate(dd)]),dtype=torch.long), torch.tensor(np.concatenate(ww)[:,None],dtype=torch.float32)


def neighbor_context(celltype_onehot, edge_index):
    src,dst=edge_index
    vals=torch.tensor(celltype_onehot,dtype=torch.float32)
    summed=scatter(vals[src],dst,dim=0,dim_size=len(vals),reduce='sum')
    deg=scatter(torch.ones((src.numel(),1)),dst,dim=0,dim_size=len(vals),reduce='sum')
    return (summed/deg.clamp_min(1)).numpy().astype(np.float32)


def negative_binomial_nll(residual,y,logN,mu0,raw_theta):
    # NB2 parameterization: Var(Y_cg) = mu_cg + mu_cg^2 / theta_g
    # theta_g is positive, gene-specific, learned jointly with the model and shared across cells
    logmu=(residual+logN[:,None]+mu0[None,:]).clamp(-12,12)
    mu=torch.exp(logmu)
    theta=F.softplus(raw_theta)+1e-4
    logtheta=torch.log(theta)
    log_theta_plus_mu=torch.logaddexp(logtheta[None,:],logmu)
    log_prob=(
        torch.lgamma(y+theta[None,:])
        -torch.lgamma(theta[None,:])
        -torch.lgamma(y+1)
        +theta[None,:]*(logtheta[None,:]-log_theta_plus_mu)
        +y*(logmu-log_theta_plus_mu)
    )
    return -log_prob.mean()


def make_mu(residual,logN,mu0):
    return torch.exp((residual+logN[:,None]+mu0[None,:]).clamp(-12,12))


def metrics(y,mu):
    yt=np.asarray(y,float).ravel(); yp=np.asarray(mu,float).ravel(); ok=np.isfinite(yt)&np.isfinite(yp); yt,yp=yt[ok],yp[ok]
    xl=np.log1p(yt); yl=np.log1p(np.clip(yp,0,None))
    return dict(raw_pearson=float(pearsonr(yt,yp).statistic),raw_spearman=float(spearmanr(yt,yp).statistic),
                raw_rmse=float(np.sqrt(mean_squared_error(yt,yp))),raw_mae=float(mean_absolute_error(yt,yp)),
                log1p_pearson=float(pearsonr(xl,yl).statistic),log1p_spearman=float(spearmanr(xl,yl).statistic),
                log1p_rmse=float(np.sqrt(mean_squared_error(xl,yl))),log1p_mae=float(mean_absolute_error(xl,yl)),n_cell_gene=len(yt))


def save_hexbin(y,mu,title,path):
    m=metrics(y,mu); x=np.log1p(np.asarray(y).ravel()); z=np.log1p(np.clip(np.asarray(mu).ravel(),0,None)); lim=max(np.percentile(x,99.9),np.percentile(z,99.9),1e-6)
    fig,ax=plt.subplots(figsize=(6.2,5.6)); hb=ax.hexbin(x,z,gridsize=80,mincnt=1,norm=LogNorm(),cmap='viridis')
    ax.plot([0,lim],[0,lim],'--',color='black',label='Perfect prediction'); ax.set_xlim(0,lim); ax.set_ylim(0,lim)
    ax.set_xlabel('log1p(true held-out counts)'); ax.set_ylabel('log1p(predicted mean)')
    ax.set_title(f"{title}\nPearson r={m['log1p_pearson']:.3f}, RMSE={m['log1p_rmse']:.3f}, MAE={m['log1p_mae']:.3f}")
    ax.legend(frameon=False); fig.colorbar(hb,ax=ax).set_label('Cell x gene observations'); fig.tight_layout(); fig.savefig(path,dpi=300,bbox_inches='tight'); plt.close(fig)


