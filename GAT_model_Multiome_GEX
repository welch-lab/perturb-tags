# Models
class MatchedMLP(nn.Module):
    def __init__(self,d,out):
        super().__init__(); self.proj=nn.Linear(d,OWN_DIM,bias=False)
        self.raw_theta=nn.Parameter(torch.full((out,),10.0))
        self.dec=nn.Sequential(nn.ELU(),nn.Dropout(DROPOUT),nn.Linear(OWN_DIM,DECODER_HIDDEN),nn.ELU(),nn.Dropout(DROPOUT),nn.Linear(DECODER_HIDDEN,DECODER_HIDDEN),nn.ELU(),nn.Linear(DECODER_HIDDEN,out))
    def forward(self,x): return self.dec(self.proj(x))

class ConcatResidualGAT(nn.Module):
    def __init__(self,d,out):
        super().__init__(); self.own=nn.Linear(d,OWN_DIM,bias=False)
        self.raw_theta=nn.Parameter(torch.full((out,),10.0))
        self.spatial=GATConv(d,SPATIAL_DIM//2,heads=2,concat=True,dropout=DROPOUT,add_self_loops=True,bias=False,edge_dim=1,fill_value=1.0)
        self.dec=nn.Sequential(nn.Linear(OWN_DIM+SPATIAL_DIM,DECODER_HIDDEN),nn.ELU(),nn.Dropout(DROPOUT),nn.Linear(DECODER_HIDDEN,DECODER_HIDDEN),nn.ELU(),nn.Linear(DECODER_HIDDEN,out))
    def forward(self,x,ei,dist,C):
        own=F.elu(self.own(x)); spatial=F.elu(self.spatial(x,ei,edge_attr=torch.exp(-dist/DISTANCE_DECAY)))
        return self.dec(F.dropout(torch.cat([own,spatial],1),DROPOUT,training=self.training))

class CellTypeContextGAT(nn.Module):
    def __init__(self,d,cdim,out):
        super().__init__(); self.own=nn.Linear(d,OWN_DIM,bias=False)
        self.raw_theta=nn.Parameter(torch.full((out,),10.0))
        self.spatial=GATConv(d,SPATIAL_DIM//2,heads=2,concat=True,dropout=DROPOUT,add_self_loops=True,bias=False,edge_dim=1,fill_value=1.0)
        self.context=nn.Sequential(nn.Linear(cdim,CONTEXT_DIM),nn.ELU())
        self.dec=nn.Sequential(nn.Linear(OWN_DIM+SPATIAL_DIM+CONTEXT_DIM,DECODER_HIDDEN),nn.ELU(),nn.Dropout(DROPOUT),nn.Linear(DECODER_HIDDEN,DECODER_HIDDEN),nn.ELU(),nn.Linear(DECODER_HIDDEN,out))
    def forward(self,x,ei,dist,C):
        own=F.elu(self.own(x)); spatial=F.elu(self.spatial(x,ei,edge_attr=torch.exp(-dist/DISTANCE_DECAY))); context=self.context(C)
        return self.dec(F.dropout(torch.cat([own,spatial,context],1),DROPOUT,training=self.training))


def forward(model,name): return model(X) if name=='mlp' else model(X,ei,dist,C)


def train(model,name,seed):
    seed_all(seed); model=model.to(DEVICE); opt=torch.optim.Adam(model.parameters(),lr=LEARNING_RATE,weight_decay=WEIGHT_DECAY); sch=torch.optim.lr_scheduler.ReduceLROnPlateau(opt,mode='min',patience=LR_PATIENCE,factor=.5,min_lr=1e-7)
    best=np.inf; state=None; stale=0; rows=[]
    for epoch in range(1,MAX_EPOCHS+1):
        model.train(); opt.zero_grad(set_to_none=True); p=forward(model,name); loss=negative_binomial_nll(p[tr],Y[tr],logN[tr],mu0,model.raw_theta); loss.backward(); torch.nn.utils.clip_grad_norm_(model.parameters(),1.0); opt.step()
        model.eval()
        with torch.no_grad(): vp=forward(model,name); vl=float(negative_binomial_nll(vp[va],Y[va],logN[va],mu0,model.raw_theta))
        sch.step(vl); rows.append(dict(epoch=epoch,train_negative_binomial_nll=float(loss),val_negative_binomial_nll=vl,lr=opt.param_groups[0]['lr']))
        if vl<best-1e-7: best=vl; state=copy.deepcopy(model.state_dict()); stale=0
        else: stale+=1
        if epoch==1 or epoch%25==0: print(name,seed,epoch,'train',float(loss),'val',vl,'best',best)
        if stale>=EARLY_STOPPING_PATIENCE: break
    if state is None: raise RuntimeError('No checkpoint')
    model.load_state_dict(state); pd.DataFrame(rows).to_csv(OUTDIR/f'{name}_seed{seed}_history.csv',index=False); torch.save(state,OUTDIR/f'{name}_seed{seed}_best.pt')
    return model


