# INDIVIDUAL CELL × GENE SCATTER PLOTS
# Each dot = one held-out cell × one modeled gene
# x = true raw count
# y = predicted Poisson mean (mu)
import numpy as np
import matplotlib.pyplot as plt
from scipy.stats import pearsonr, spearmanr
from sklearn.metrics import mean_squared_error, mean_absolute_error


def save_cell_gene_scatter(
    true_counts,
    predicted_mu,
    model_label,
    output_path,
    use_log1p=False,
):
    true_counts = np.asarray(true_counts, dtype=np.float64).ravel()
    predicted_mu = np.asarray(predicted_mu, dtype=np.float64).ravel()

    valid = (
        np.isfinite(true_counts)
        & np.isfinite(predicted_mu)
        & (true_counts >= 0)
        & (predicted_mu >= 0)
    )

    true_counts = true_counts[valid]
    predicted_mu = predicted_mu[valid]

    if use_log1p:
        x = np.log1p(true_counts)
        y = np.log1p(predicted_mu)
        scale_name = "log1p"
        x_label = "log1p(true held-out count)"
        y_label = "log1p(predicted mean mu)"
    else:
        x = true_counts
        y = predicted_mu
        scale_name = "raw"
        x_label = "True held-out raw count"
        y_label = "Predicted raw mean count (mu)"

    pearson = pearsonr(x, y).statistic
    spearman = spearmanr(x, y).statistic
    rmse = np.sqrt(mean_squared_error(x, y))
    mae = mean_absolute_error(x, y)

    # Keep extreme outliers from making the central distribution unreadable
    axis_max = max(
        np.percentile(x, 99.9),
        np.percentile(y, 99.9),
        1.0,
    )

    fig, ax = plt.subplots(figsize=(7, 7))

    ax.scatter(
        x,
        y,
        s=3,
        alpha=0.08,
        linewidths=0,
        rasterized=True,
    )

    ax.plot(
        [0, axis_max],
        [0, axis_max],
        linestyle="--",
        linewidth=2,
        color="black",
        label="Perfect prediction",
    )

    ax.set_xlim(0, axis_max)
    ax.set_ylim(0, axis_max)
    ax.set_xlabel(x_label)
    ax.set_ylabel(y_label)

    ax.set_title(
        f"{model_label}: individual cell × gene observations\n"
        f"Pearson r={pearson:.3f}, "
        f"Spearman={spearman:.3f}, "
        f"RMSE={rmse:.3f}, "
        f"MAE={mae:.3f}"
    )

    ax.legend(frameon=False)
    fig.tight_layout()

    fig.savefig(
        output_path,
        dpi=300,
        bbox_inches="tight",
    )

    plt.show()
    plt.close(fig)

    print(
        f"{model_label} {scale_name}: "
        f"Pearson={pearson:.6f}, "
        f"Spearman={spearman:.6f}, "
        f"RMSE={rmse:.6f}, "
        f"MAE={mae:.6f}, "
        f"n_cell_gene={len(x)}"
    )


