cell_records = []

for row in top_clone_df.itertuples():
    barcodes = row.cell_barcodes.split(";")

    for barcode in barcodes:
        cell_records.append({
            "clone_id": row.clone_id,
            "guide_combination": row.guide_combination,
            "clone_size": row.clone_size,
            "cell_barcode": barcode,
            "cell_type": adata.obs.loc[barcode, cell_type_col]
        })

clone_cell_df = pd.DataFrame(cell_records)
clone_cell_df["cell_type"] = clone_cell_df["cell_type"].astype(str)


# Count cell types per gRNA
stack_df = (
    clone_cell_df
    .groupby(["guide_combination", "cell_type"])
    .size()
    .reset_index(name="n_cells")
)

stack_matrix = (
    stack_df
    .pivot(index="guide_combination", columns="cell_type", values="n_cells")
    .reindex(index=combo_order)
    .fillna(0)
)

cell_type_order = [
    "Pluripotent",
    "Neural Crest",
    "Endoderm",
    "Early Ectoderm",
    "Neurons",
    "Mesoderm"
]

cell_type_order = [
    ct for ct in cell_type_order if ct in stack_matrix.columns
] + [
    ct for ct in stack_matrix.columns if ct not in cell_type_order
]

stack_matrix = stack_matrix[cell_type_order]
plt.rcParams.update({
    "font.family": "DejaVu Sans",
    "font.size": 10,
    "axes.linewidth": 1.1,
    "axes.labelsize": 12,
    "axes.titlesize": 13,
    "xtick.labelsize": 9,
    "ytick.labelsize": 10,
    "legend.fontsize": 9,
    "legend.title_fontsize": 10,
    "pdf.fonttype": 42,
    "ps.fonttype": 42,
    "svg.fonttype": "none"
})

cell_type_colors = {
    "Pluripotent": "#1f77b4",     
    "Neural Crest": "#ff7f0e",    
    "Endoderm": "#2ca02c",        
    "Early Ectoderm": "#d62728",  
    "Neurons": "#A142F4",         
    "Mesoderm": "#8c564b"         
}

fallback_palette = [
    "#8C8C8C",
    "#64B5CD",
    "#CCB974",
    "#DA8BC3",
    "#7FC97F",
    "#BEAED4"
]

colors = [
    cell_type_colors.get(cell_type, fallback_palette[i % len(fallback_palette)])
    for i, cell_type in enumerate(stack_matrix.columns)
]

spacing_factor = 0.42
bar_width = 0.30
x_positions = np.arange(len(stack_matrix.index)) * spacing_factor
fig, ax = plt.subplots(figsize=(12.4, 5.4))
bottom = np.zeros(len(stack_matrix))
for cell_type, color in zip(stack_matrix.columns, colors):
    values = stack_matrix[cell_type].values
    ax.bar(
        x_positions,
        values,
        bottom=bottom,
        width=bar_width,
        label=cell_type,
        color=color,
        edgecolor="white",
        linewidth=0.45
    )

    bottom += values

ax.set_xticks(x_positions)
ax.set_xticklabels(
    stack_matrix.index,
    rotation=90,
    ha="center",
    va="top"
)
ax.set_ylabel("Number of clone cells")
ax.set_xlabel("Exact gRNA combination")
ax.set_title(
    f"Cell-type composition of clone cells for top {TOP_N} gRNA combinations\n"
    f"Connected components defined by exact guide-combination matching, radius = {RADIUS}",
    pad=12
)

ax.grid(False)
ax.spines["top"].set_visible(False)
ax.spines["right"].set_visible(False)
ax.spines["left"].set_linewidth(1.1)
ax.spines["bottom"].set_linewidth(1.1)
ax.tick_params(
    axis="both",
    which="major",
    direction="out",
    length=4,
    width=1.0
)
ax.set_xlim(x_positions[0] - 0.28, x_positions[-1] + 0.28)
ax.legend(
    title=cell_type_col,
    bbox_to_anchor=(1.02, 1),
    loc="upper left",
    frameon=False,
    handlelength=1.0,
    handletextpad=0.5,
    borderaxespad=0.0
)
fig.tight_layout()
plt.show()
