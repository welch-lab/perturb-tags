                        ax.plot(sub["bin_mid"], sub["mean_lr_score"], marker="o", linewidth=0.9, markersize=2.3)
                        kd, lr_type, lr_name, interaction_id = key
                        stat = results[
                            (results["kd_gene"] == kd)
                            & (results["lr_type"] == lr_type)
                            & (results["lr_name"] == lr_name)
                            & (results["interaction_id"] == interaction_id)
                        ].iloc[0]
                        ax.set_title(
                            f"{kd} KD -> {lr_name}\n"
                            f"rho={stat['rho_distance']:.2f}; "
                            f"dir={stat['significant_direction']}",
