def safe_name(value: str) -> str:
    return re.sub(r"[^A-Za-z0-9_.-]+", "_", str(value)).strip("_")


def stable_seed(*parts: object) -> int:
    joined = "|".join(str(part) for part in parts).encode("utf-8")
    digest = hashlib.sha256(joined).hexdigest()[:16]
    return int(digest, 16) % np.iinfo(np.int32).max


def current_mode(config: AnalysisConfig) -> str:
    mode = os.environ.get(f"{config.env_prefix}_MODE", "full").strip().lower()
    if mode not in {"full", "compute", "aggregate"}:
        raise ValueError(f"{config.env_prefix}_MODE must be one of: full, compute, aggregate")
    return mode


def resolve_targets(config: AnalysisConfig, all_targets: Sequence[str]) -> List[str]:
    explicit_target = os.environ.get(f"{config.env_prefix}_TARGET", "").strip()
    if explicit_target:
        if explicit_target not in all_targets:
            raise ValueError(f"Unknown {config.env_prefix}_TARGET: {explicit_target}")
        return [explicit_target]

    explicit_targets = os.environ.get(f"{config.env_prefix}_TARGETS", "").strip()
    if explicit_targets:
        parsed = [token.strip() for token in explicit_targets.split(",") if token.strip()]
        unknown = [token for token in parsed if token not in all_targets]
        if unknown:
            raise ValueError(f"Unknown {config.env_prefix}_TARGETS values: {unknown}")
        return parsed

    raw_index = os.environ.get(f"{config.env_prefix}_TARGET_INDEX", "").strip()
    if not raw_index:
        raw_index = os.environ.get("SLURM_ARRAY_TASK_ID", "").strip()
    if raw_index:
        idx = int(raw_index)
        if 1 <= idx <= len(all_targets):
            return [all_targets[idx - 1]]
        if 0 <= idx < len(all_targets):
            return [all_targets[idx]]
        raise ValueError(f"{config.env_prefix} target index out of range: {idx}")

    return list(all_targets)


