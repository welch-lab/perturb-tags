def guide_has_gene(s: str, gene: str) -> bool:
    if not s or str(s).lower() in {"nan", "none"}:
        return False
    for token in re.split(r"[;,|\s]+", str(s)):
        token = token.strip()
        if not token:
            continue
        target = re.sub(r"-\d+$", "", token)
        if target.upper() == gene.upper():
            return True
    return False


def canonicalize_eb(x: str) -> str:
    s = str(x)
    match = re.search(r"(?:EB[_-]?)?(\d+)$", s, flags=re.I)
    return f"EB_{int(match.group(1))}" if match else s


def build_alias_map(obs: pd.DataFrame) -> dict[str, str]:
    aliases: dict[str, str] = {}
    for idx, row in obs.iterrows():
        canonical = str(idx)
        candidates = {canonical, canonical.removesuffix("-1")}
        lane = str(row.get("lane", ""))
        for column in ["global_cell_id", "gex_barcode", "raw_cell_barcode", "barcode_raw"]:
            if column not in obs.columns:
                continue
            value = str(row[column])
            if not value or value.lower() == "nan":
                continue
            candidates.add(value)
            candidates.add(value.removesuffix("-1"))
            if lane:
                candidates.add(f"{lane}_{value}")
                candidates.add(f"{lane}_{value.removesuffix('-1')}")
        for alias in candidates:
            if alias:
                aliases.setdefault(alias, canonical)
    return aliases


def identify_lr_annotation_columns(lr_dataframe: pd.DataFrame) -> List[str]:
    possible_exact_names = {
        "ligand", "ligand_gene", "ligand_genes", "ligand_symbol", "ligand_symbols",
        "receptor", "receptor_gene", "receptor_genes", "receptor_symbol", "receptor_symbols",
        "source", "source_gene", "source_genes", "target", "target_gene", "target_genes",
        "sender", "receiver", "partner_a", "partner_b", "gene_a", "gene_b",
    }
    annotation_columns = ["lr_name"]
    for column in lr_dataframe.columns:
        column_lower = column.lower()
        if column_lower in possible_exact_names:
            annotation_columns.append(column)
        elif "ligand" in column_lower or "receptor" in column_lower:
            annotation_columns.append(column)
    return list(dict.fromkeys(annotation_columns))


def resolve_lr_columns(df: pd.DataFrame) -> pd.DataFrame:
    lower = {column.lower(): column for column in df.columns}
    required = {
        "cell_id": ["cell_id", "cell", "barcode"],
        "interaction_id": ["interaction_id", "interaction", "lr_id"],
        "lr_name": ["lr_name", "interaction_name", "name"],
        "lr_score": ["lr_score", "score", "value"],
    }
    rename = {}
    for out, choices in required.items():
        found = next((lower[c] for c in choices if c in lower), None)
        if found is None:
            raise ValueError(f"LR CSV is missing {out}. Columns: {list(df.columns)}")
        rename[found] = out
    optional = {
        "lr_type": ["lr_type", "type"],
        "ligand_name": ["ligand_name", "ligand"],
        "receptor_name": ["receptor_name", "receptor"],
        "EB": ["eb", "eb_cluster", "eb_manual_clustering"],
    }
    for out, choices in optional.items():
        found = next((lower[c] for c in choices if c in lower), None)
        if found is not None:
            rename[found] = out
    return df.rename(columns=rename)


def normalize_component_text(value: str) -> str:
    return re.sub(r"[^A-Z0-9]+", "", str(value).upper())


def component_has_kd(component_value: str, kd_gene: str) -> bool:
    component_raw = str(component_value).upper()
    component_compact = normalize_component_text(component_raw)
    identifiers = KD_COMPONENT_IDENTIFIERS.get(kd_gene.upper(), {kd_gene.upper()})
    for identifier in identifiers:
        identifier_raw = str(identifier).upper()
        exact = rf"(?<![A-Z0-9]){re.escape(identifier_raw)}(?![A-Z0-9])"
        if re.search(exact, component_raw):
            return True
        if normalize_component_text(identifier_raw) == component_compact:
            return True
    return False


def extract_all_kd_genes(obs: pd.DataFrame) -> List[str]:
    excluded = {"", "UNASSIGNED", "NON-TARGETING", "NO_CRISPR_DATA", "NAN", "NONE"}
    genes = {
        str(x).strip().upper()
        for x in obs["target_call"].astype(str)
        if str(x).strip().upper() not in excluded
    }
    for s in obs["guide_string"]:
        for token in re.split(r"[;,|\s]+", str(s)):
            token = token.strip()
            if not token or token.lower().startswith("negative control"):
                continue
            target = re.sub(r"-\d+$", "", token).strip().upper()
            if target and target not in excluded:
                genes.add(target)
    return sorted(genes)


def select_direct_tests(lr_meta: pd.DataFrame, kd_genes: Sequence[str]) -> pd.DataFrame:
    required = {"ligand_name", "receptor_name"}
    missing = required - set(lr_meta.columns)
    if missing:
        raise ValueError(f"LR CSV is missing required component columns: {sorted(missing)}")
    rows = []
    for kd in kd_genes:
        mask = (
            lr_meta["ligand_name"].map(lambda value: component_has_kd(value, kd))
            | lr_meta["receptor_name"].map(lambda value: component_has_kd(value, kd))
        )
        sub = lr_meta.loc[mask].copy()
        if not sub.empty:
            sub["kd_gene"] = kd
            rows.append(sub)
    out = pd.concat(rows, ignore_index=True) if rows else pd.DataFrame()
    keep = ["kd_gene", "lr_type", "lr_name", "interaction_id", "ligand_name", "receptor_name"]
    keep = [column for column in keep if column in out.columns]
    out = out[keep].drop_duplicates().reset_index(drop=True) if not out.empty else out
    if out.empty:
        raise ValueError("No direct KD-LR tests matched ligand_name or receptor_name.")
    return out


def select_compensatory_tests(
    lr_meta: pd.DataFrame,
    compensatory_tests: Sequence[Tuple[str, str, str, str]],
) -> pd.DataFrame:
    curated = pd.DataFrame(
        compensatory_tests,
        columns=["kd_gene", "lr_type", "lr_name", "interaction_id"],
    )
    by_id = curated.merge(lr_meta, on="interaction_id", how="inner", suffixes=("_curated", ""))
    if by_id.empty:
        by_id = curated.merge(lr_meta, on="lr_name", how="inner", suffixes=("_curated", ""))
    if "lr_type_curated" in by_id.columns:
        by_id["lr_type"] = by_id["lr_type"].fillna(by_id["lr_type_curated"])
    out = by_id
    keep = [c for c in ["kd_gene", "lr_type", "lr_name", "interaction_id", "ligand_name", "receptor_name"] if c in out.columns]
    out = out[keep].drop_duplicates().reset_index(drop=True)
    if out.empty:
        raise ValueError("No compensatory KD-LR tests matched the LR CSV.")
    return out


def pairwise_distance_matrix(coords: np.ndarray) -> np.ndarray:
    coords32 = np.asarray(coords, dtype=np.float32)
    delta = coords32[:, None, :] - coords32[None, :, :]
    squared = np.sum(delta * delta, axis=2, dtype=np.float32)
    distances = np.sqrt(squared).astype(np.float32, copy=False)
    np.fill_diagonal(distances, 0.0)
    return distances


def nearest_reference_distances_from_matrix(distance_matrix: np.ndarray, reference_indices: np.ndarray) -> np.ndarray:
    if len(reference_indices) < 1:
        raise ValueError("No reference cells")
    if len(reference_indices) == 1:
        return distance_matrix[:, reference_indices[0]].astype(np.float32, copy=False)
    return distance_matrix[:, reference_indices].min(axis=1).astype(np.float32, copy=False)


def rank_vector(values: np.ndarray) -> np.ndarray:
    try:
        return np.asarray(rankdata(values, method="average"), dtype=np.float64)
    except TypeError:
        return np.asarray(rankdata(values), dtype=np.float64)


def rank_columns(values: np.ndarray) -> np.ndarray:
    try:
        return np.asarray(rankdata(values, axis=0, method="average"), dtype=np.float64)
    except TypeError:
        return pd.DataFrame(values).rank(axis=0, method="average").to_numpy(dtype=np.float64, copy=False)


def centered_rank_vector(values: np.ndarray) -> Tuple[np.ndarray, float]:
    ranks = rank_vector(values)
    ranks -= ranks.mean()
    scale = float(np.sqrt(np.dot(ranks, ranks)))
    return ranks, scale


def spearman_rho_block_no_nan(ranked_x: np.ndarray, scale_x: float, values: np.ndarray) -> np.ndarray:
    if values.shape[0] < MIN_RECEIVERS or not np.isfinite(scale_x) or scale_x == 0.0:
        return np.full(values.shape[1], np.nan, dtype=float)
    ranked_y = rank_columns(values)
    ranked_y -= ranked_y.mean(axis=0, keepdims=True)
    scale_y = np.sqrt((ranked_y * ranked_y).sum(axis=0))
    numerator = ranked_x @ ranked_y
    return np.divide(
        numerator,
        scale_x * scale_y,
        out=np.full(values.shape[1], np.nan, dtype=float),
        where=scale_y > 0,
    )


def bin_profile(dist: np.ndarray, score: np.ndarray) -> pd.DataFrame:
    rows = []
    for i, (lo, hi) in enumerate(zip(BIN_EDGES[:-1], BIN_EDGES[1:])):
        mask = (dist >= lo) & ((dist < hi) if i < len(BIN_MIDS) - 1 else (dist <= hi))
        vals = score[mask]
        rows.append({
            "bin_index": i + 1,
            "bin_start": lo,
            "bin_end": hi,
            "bin_mid": BIN_MIDS[i],
            "n_cells": int(mask.sum()),
            "mean_lr_score": float(np.nanmean(vals)) if mask.sum() else np.nan,
            "sem_lr_score": (
                float(np.nanstd(vals, ddof=1) / np.sqrt(np.isfinite(vals).sum()))
                if np.isfinite(vals).sum() > 1 else np.nan
            ),
        })
    return pd.DataFrame(rows)


def initialize_permutation_state(
    observed_results: pd.DataFrame,
    dense_scores: np.ndarray,
    null_dir_root: Path,
    unit_label: str,
) -> dict:
    null_chunk_dir = null_dir_root / safe_name(f"{unit_label}_null_rho_chunks")
    if null_chunk_dir.exists():
        shutil.rmtree(null_chunk_dir)
    null_chunk_dir.mkdir(parents=True, exist_ok=True)
    return {
        "observed_rhos": observed_results["rho_distance"].to_numpy(dtype=float),
        "dense_scores": dense_scores,
        "positive_tail_counts": np.zeros(len(observed_results), dtype=np.int64),
        "negative_tail_counts": np.zeros(len(observed_results), dtype=np.int64),
        "valid_perm_counts": np.zeros(len(observed_results), dtype=np.int64),
        "null_chunk_dir": null_chunk_dir,
        "null_manifest_rows": [],
        "manifest_path": null_chunk_dir / "manifest.csv",
    }


def update_state_for_permutation(
    state: dict,
    score_index: np.ndarray,
    ranked_x: np.ndarray,
    scale_x: float,
    chunk_column: int,
    chunk_null_rhos: Optional[np.ndarray],
) -> None:
    observed_rhos = state["observed_rhos"]
    dense_scores = state["dense_scores"]
    for start in range(0, dense_scores.shape[1], TEST_BLOCK_SIZE):
        stop = min(start + TEST_BLOCK_SIZE, dense_scores.shape[1])
        block = dense_scores[score_index, start:stop]
        rho_block = spearman_rho_block_no_nan(ranked_x, scale_x, block)
        if chunk_null_rhos is not None:
            chunk_null_rhos[start:stop, chunk_column] = rho_block.astype(np.float32, copy=False)
        finite = np.isfinite(rho_block)
        state["valid_perm_counts"][start:stop] += finite.astype(np.int64)
        state["positive_tail_counts"][start:stop] += (
            finite & (rho_block >= observed_rhos[start:stop])
        ).astype(np.int64)
        state["negative_tail_counts"][start:stop] += (
            finite & (rho_block <= observed_rhos[start:stop])
        ).astype(np.int64)


def flush_null_chunk(
    state: dict,
    unit_label: str,
    chunk_start: int,
    chunk_stop: int,
    chunk_null_rhos: Optional[np.ndarray],
) -> None:
    if chunk_null_rhos is None:
        return
    chunk_path = state["null_chunk_dir"] / safe_name(
        f"{unit_label}_null_rhos_perm_{chunk_start:06d}_{chunk_stop - 1:06d}.npz"
    )
    np.savez_compressed(chunk_path, null_rhos=chunk_null_rhos)
    state["null_manifest_rows"].append({
        "unit_label": unit_label,
        "perm_start_inclusive": chunk_start,
        "perm_stop_exclusive": chunk_stop,
        "n_tests": int(chunk_null_rhos.shape[0]),
        "n_permutations": int(chunk_null_rhos.shape[1]),
        "dtype": "float32",
        "path": str(chunk_path),
    })


def finalize_permutation_state(state: dict) -> dict:
    valid_counts = state["valid_perm_counts"]
    positive_counts = state["positive_tail_counts"]
    negative_counts = state["negative_tail_counts"]
    p_positive = np.full(len(valid_counts), np.nan, dtype=float)
    p_negative = np.full(len(valid_counts), np.nan, dtype=float)
    valid = valid_counts > 0
    p_positive[valid] = (1.0 + positive_counts[valid]) / (1.0 + valid_counts[valid])
    p_negative[valid] = (1.0 + negative_counts[valid]) / (1.0 + valid_counts[valid])
    pd.DataFrame(state["null_manifest_rows"]).to_csv(state["manifest_path"], index=False)
    return {
        "p_positive": p_positive,
        "p_negative": p_negative,
        "positive_tail_counts": positive_counts,
        "negative_tail_counts": negative_counts,
        "valid_counts": valid_counts,
        "manifest_path": str(state["manifest_path"]),
        "chunk_dir": str(state["null_chunk_dir"]),
    }


def plot_dataset_level_group(sub: pd.DataFrame, title: str, path_base: Path) -> None:
    fig, ax = plt.subplots(figsize=(6.5, 4.8))
    sub = sub.sort_values("bin_mid")
    ax.plot(sub["bin_mid"], sub["mean_lr_score"], marker="o", linewidth=1.4, markersize=3.6)
    ax.fill_between(
        sub["bin_mid"].to_numpy(dtype=float),
        (sub["mean_lr_score"] - sub["sem_lr_score"]).to_numpy(dtype=float),
        (sub["mean_lr_score"] + sub["sem_lr_score"]).to_numpy(dtype=float),
        alpha=0.18,
    )
    ax.set_title(title, fontsize=10, weight="bold")
    ax.set_xlabel("Distance to nearest KD cell within EB (µm)")
    ax.set_ylabel("Mean CytoSignal LR score")
    ax.set_xlim(0, MAX_DISTANCE)
    ax.spines["top"].set_visible(False)
    ax.spines["right"].set_visible(False)
    fig.tight_layout()
    fig.savefig(path_base.with_suffix(".png"), dpi=600, bbox_inches="tight")
    fig.savefig(path_base.with_suffix(".pdf"), bbox_inches="tight")
    plt.close(fig)


def run_analysis(config: AnalysisConfig) -> None:
    mode = current_mode(config)
    output_dir = DATA_DIR / config.output_name
    result_dir = output_dir / "dataset_level_results"
    profile_dir = output_dir / "dataset_level_bin_profiles"
    plot_dir = output_dir / "significant_dataset_level_plots"
    null_dir = output_dir / "saved_null_rho_distributions"
    for directory in (output_dir, result_dir, profile_dir, plot_dir, null_dir):
        directory.mkdir(parents=True, exist_ok=True)

    raw_result_pattern = f"*_dataset_level_{config.mode_name}_KD_LR_results_RAW.csv"
    raw_profile_pattern = f"*_dataset_level_{config.mode_name}_KD_LR_bin_profiles_RAW.csv"

    def collect_raw_result_files() -> List[Path]:
        return sorted(
            path for path in result_dir.glob(raw_result_pattern)
            if not path.name.startswith("ALL_")
        )

    def collect_raw_profile_files() -> List[Path]:
        return sorted(
            path for path in profile_dir.glob(raw_profile_pattern)
            if not path.name.startswith("ALL_")
        )

    def run_aggregate_only() -> None:
        raw_result_files = collect_raw_result_files()
        raw_profile_files = collect_raw_profile_files()
        if not raw_result_files:
            raise FileNotFoundError("No per-KD raw dataset-level result files found for aggregation.")

        results = pd.concat([pd.read_csv(path) for path in raw_result_files], ignore_index=True)
        profiles = (
            pd.concat([pd.read_csv(path) for path in raw_profile_files], ignore_index=True)
            if raw_profile_files else pd.DataFrame()
        )
        if results.empty:
            print("\nNo dataset-level KD x LR tests completed.")
            return

        results["fdr_positive_one_sided"] = np.nan
        results["fdr_negative_one_sided"] = np.nan
        for kd_gene, idx in results.groupby("kd_gene").groups.items():
            idx = list(idx)
            p_pos = results.loc[idx, "p_positive_one_sided"]
            p_neg = results.loc[idx, "p_negative_one_sided"]
            valid_pos = p_pos.notna()
            valid_neg = p_neg.notna()
            if valid_pos.any():
                results.loc[p_pos[valid_pos].index, "fdr_positive_one_sided"] = multipletests(
                    p_pos[valid_pos], method="fdr_bh"
                )[1]
            if valid_neg.any():
                results.loc[p_neg[valid_neg].index, "fdr_negative_one_sided"] = multipletests(
                    p_neg[valid_neg], method="fdr_bh"
                )[1]

        results["passes_fdr_positive"] = results["fdr_positive_one_sided"] < FDR_THRESHOLD
        results["passes_fdr_negative"] = results["fdr_negative_one_sided"] < FDR_THRESHOLD
        results["significant_any_direction"] = results["passes_fdr_positive"] | results["passes_fdr_negative"]
        results["significant_direction"] = np.select(
            [
                results["passes_fdr_positive"] & results["passes_fdr_negative"],
                results["passes_fdr_positive"],
                results["passes_fdr_negative"],
            ],
            ["both", "positive", "negative"],
            default="none",
        )

        result_all_path = result_dir / "ALL_KD_dataset_level_KD_LR_results.csv"
        result_sig_path = result_dir / "ALL_FDR_passing_dataset_level_KD_LR_results.csv"
