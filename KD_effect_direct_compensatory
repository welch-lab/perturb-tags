                        ax.set_xlim(0, MAX_DISTANCE)
                        ax.spines["top"].set_visible(False)
                        ax.spines["right"].set_visible(False)
                        ax.tick_params(labelsize=7)
                    for ax in axes.ravel()[len(page_keys):]:
                        ax.axis("off")
                    fig.supxlabel("Distance to nearest KD cell within EB (µm)")
                    fig.supylabel("Mean CytoSignal LR score")
                    fig.suptitle(
                        f"FDR-passing dataset-level {config.mode_name} KD-LR effects",
                        weight="bold",
                    )
                    fig.tight_layout(rect=[0.03, 0.03, 1, 0.95])
                    pdf.savefig(fig, bbox_inches="tight")
                    plt.close(fig)

        print("\nDONE")
        print("Output:", output_dir)
        print("Dataset-level KD-LR tests:", len(results))
        print("FDR-passing dataset-level tests:", int(results["significant_any_direction"].sum()))

    print(f"Run mode: {mode}")
    print(f"Save full nulls: {save_full_nulls(config)}")
    print(f"Null chunk size: {null_chunk_size(config):,}")
    print(f"Permutations: {n_permutations(config):,}")
    print("Analysis design: dataset-level pooled receivers, one-sided positive/negative tests, BH across LR tests within each KD.")
    print("Permutation scheme: global spatial shuffle of whole-cell profiles across all positions, then re-derive KD cells and receivers.")
    if mode == "aggregate":
        run_aggregate_only()
        return

    print("Loading MuData...")
    mdata = md.read_h5mu(H5MU_PATH)
    rna = mdata.mod["rna"]
    obs = rna.obs.copy()
    obs.index = obs.index.astype(str)
    obs["cell_id"] = obs.index
    obs["EB"] = obs[EB_COL].astype(str).map(canonicalize_eb)
    obs["guide_string"] = obs[GUIDE_COL].fillna("").astype(str)
    coords_all = np.asarray(rna.obsm["X_spatial"], dtype=float)
    if coords_all.shape != (len(obs), 2) or not np.isfinite(coords_all).all():
        raise ValueError("Invalid X_spatial coordinates.")

    print("Loading LR long sparse CSV...")
    lr = resolve_lr_columns(pd.read_csv(LR_PATH, low_memory=False))
    lr["cell_id"] = lr["cell_id"].astype(str)
    lr["interaction_id"] = lr["interaction_id"].astype(str)
    lr["lr_name"] = lr["lr_name"].astype(str)
    lr["lr_score"] = pd.to_numeric(lr["lr_score"], errors="coerce").fillna(0.0)
    if "lr_type" not in lr.columns:
        lr["lr_type"] = "unknown"

    alias_map = build_alias_map(obs)
    lr["canonical_cell_id"] = lr["cell_id"].map(alias_map)
    matched = int(lr["canonical_cell_id"].notna().sum())
    print(f"LR rows matched to MuData cells: {matched:,}/{len(lr):,}")
    if matched == 0:
        raise ValueError("No LR CSV cell IDs matched MuData. Inspect LR cell_id format.")
    lr = lr.dropna(subset=["canonical_cell_id"]).copy()

    if config.mode_name == "direct":
        annotation_columns = identify_lr_annotation_columns(lr)
        lr_meta_cols = ["lr_type", "interaction_id"]
        for column in annotation_columns:
            if column in lr.columns and column not in lr_meta_cols:
                lr_meta_cols.append(column)
        lr_meta = lr[lr_meta_cols].drop_duplicates(subset=["lr_type", "interaction_id"])
        kd_genes = extract_all_kd_genes(obs)
        tests = select_direct_tests(lr_meta, kd_genes)
    else:
        lr_meta_cols = [c for c in ["lr_type", "interaction_id", "lr_name", "ligand_name", "receptor_name"] if c in lr.columns]
        lr_meta = lr[lr_meta_cols].drop_duplicates()
        tests = select_compensatory_tests(lr_meta, config.compensatory_tests)

    tests.to_csv(output_dir / f"selected_{config.mode_name}_KD_LR_tests.csv", index=False)
    selected_targets = resolve_targets(config, sorted(tests["kd_gene"].unique().tolist()))
    print(f"Selected KD targets ({len(selected_targets)}): {selected_targets}")

    if config.mode_name == "direct":
        lr_scores = (
            lr.groupby(["lr_type", "interaction_id", "canonical_cell_id"], as_index=False)["lr_score"]
            .mean()
        )
        score_groups = {
            (str(lr_type), str(interaction_id)): group.set_index("canonical_cell_id")["lr_score"]
            for (lr_type, interaction_id), group in lr_scores.groupby(["lr_type", "interaction_id"])
        }
    else:
        lr_scores = (
            lr.groupby(["interaction_id", "canonical_cell_id"], as_index=False)["lr_score"]
            .mean()
        )
        score_groups = {
            str(interaction_id): group.set_index("canonical_cell_id")["lr_score"]
            for interaction_id, group in lr_scores.groupby("interaction_id")
        }

    print("Precomputing EB cell indices and pairwise distance matrices...")
    eb_indices_map: Dict[str, np.ndarray] = {}
    eb_distance_matrices: Dict[str, np.ndarray] = {}
    cell_ids_all = obs.index.to_numpy()
    guide_strings_all = obs["guide_string"].to_numpy()
    for eb, eb_labels in obs.groupby("EB", sort=True).groups.items():
        eb_idx = np.asarray([obs.index.get_loc(cell_id) for cell_id in eb_labels], dtype=int)
        eb_key = str(eb)
        eb_indices_map[eb_key] = eb_idx
        eb_distance_matrices[eb_key] = pairwise_distance_matrix(coords_all[eb_idx])
    print(f"Precomputed pairwise distance matrices for {len(eb_indices_map):,} EBs")

    print("\n" + "#" * 90)
    print(f"RUNNING DATASET-LEVEL {config.mode_name.upper()} KD x LR ANALYSIS")
    print("#" * 90)

    for kd_gene in selected_targets:
        kd_tests = tests[tests["kd_gene"] == kd_gene].copy()
        if kd_tests.empty:
            print(f"KD TARGET: {kd_gene} | {config.mode_name.upper()} | no matched tests; skipping")
            continue

        print("\n" + "=" * 90)
        print(f"KD TARGET: {kd_gene} | {config.mode_name.upper()}")
        print("=" * 90)

        dense_columns: List[np.ndarray] = []
        test_meta_rows: List[dict] = []
        for test in kd_tests.itertuples(index=False):
            if config.mode_name == "direct":
                key = (str(getattr(test, "lr_type", "unknown")), str(test.interaction_id))
            else:
                key = str(test.interaction_id)
            series = score_groups.get(key)
            if series is None:
                continue
            dense_columns.append(series.reindex(cell_ids_all).fillna(0.0).to_numpy(dtype=np.float32))
            test_meta_rows.append({
                "mode": config.mode_name,
                "kd_gene": kd_gene,
                "lr_type": str(getattr(test, "lr_type", "unknown")),
                "lr_name": str(test.lr_name),
                "interaction_id": str(test.interaction_id),
            })

        if not dense_columns:
            continue

        dense_scores_all = np.column_stack(dense_columns).astype(np.float32, copy=False)
        kd_global = np.fromiter(
            (guide_has_gene(label, kd_gene) for label in guide_strings_all),
            dtype=bool,
            count=len(guide_strings_all),
        )

        observed_receiver_positions: List[np.ndarray] = []
        observed_distance_chunks: List[np.ndarray] = []
        eligible_eb_rows: List[dict] = []
        total_kd = 0
        total_non_kd = 0
        for eb_key, eb_idx in eb_indices_map.items():
            kd_mask = kd_global[eb_idx]
            n_kd = int(kd_mask.sum())
            n_non_kd = int((~kd_mask).sum())
            if n_kd < MIN_KD_CELLS_PER_EB or n_non_kd < MIN_RECEIVERS:
                continue
            observed_dist_all = nearest_reference_distances_from_matrix(
                eb_distance_matrices[eb_key], np.flatnonzero(kd_mask)
            )
            observed_receiver_mask = (~kd_mask) & np.isfinite(observed_dist_all) & (observed_dist_all <= MAX_DISTANCE)
            if int(observed_receiver_mask.sum()) < MIN_RECEIVERS:
                continue
            observed_receiver_positions.append(eb_idx[observed_receiver_mask])
            observed_distance_chunks.append(observed_dist_all[observed_receiver_mask].astype(np.float64, copy=False))
            eligible_eb_rows.append({
                "kd_gene": kd_gene,
                "EB": eb_key,
                "n_cells": int(len(eb_idx)),
                "n_kd": n_kd,
                "n_non_kd": n_non_kd,
                "n_receivers": int(observed_receiver_mask.sum()),
            })
            total_kd += n_kd
            total_non_kd += n_non_kd

        if not observed_receiver_positions:
            print("  No eligible EBs with observed receivers; skipping.")
            continue

        pooled_receiver_positions = np.concatenate(observed_receiver_positions)
        pooled_observed_dist = np.concatenate(observed_distance_chunks)
        if pooled_observed_dist.size < MIN_RECEIVERS:
            print("  Too few pooled observed receivers; skipping.")
            continue

        observed_scores = dense_scores_all[pooled_receiver_positions]
        ranked_x_obs, scale_x_obs = centered_rank_vector(pooled_observed_dist)
        observed_rows: List[dict] = []
        profile_rows: List[dict] = []
        for start in range(0, observed_scores.shape[1], TEST_BLOCK_SIZE):
            stop = min(start + TEST_BLOCK_SIZE, observed_scores.shape[1])
            block = observed_scores[:, start:stop]
            rho_block = spearman_rho_block_no_nan(ranked_x_obs, scale_x_obs, block)
            for local_index in range(block.shape[1]):
                test_position = start + local_index
                meta = test_meta_rows[test_position].copy()
                meta["rho_distance"] = float(rho_block[local_index]) if np.isfinite(rho_block[local_index]) else np.nan
                meta["n_cells_total"] = int(len(cell_ids_all))
                meta["n_kd_total_across_eligible_EBs"] = int(total_kd)
                meta["n_non_kd_total_across_eligible_EBs"] = int(total_non_kd)
                meta["n_eligible_EBs"] = int(len(eligible_eb_rows))
                meta["n_receivers_pooled_within_300um"] = int(pooled_observed_dist.size)
                observed_rows.append(meta)

                profile = bin_profile(pooled_observed_dist, block[:, local_index].astype(float, copy=False))
                profile["mode"] = config.mode_name
                profile["kd_gene"] = meta["kd_gene"]
                profile["lr_type"] = meta["lr_type"]
                profile["lr_name"] = meta["lr_name"]
                profile["interaction_id"] = meta["interaction_id"]
                profile_rows.extend(profile.to_dict("records"))

        observed_results = pd.DataFrame(observed_rows)
        valid_mask = np.isfinite(observed_results["rho_distance"].to_numpy(dtype=float))
        observed_results = observed_results.loc[valid_mask].reset_index(drop=True)
        if observed_results.empty:
            print("  No valid observed LR tests after ranking checks; skipping.")
            continue

        dense_scores_all = dense_scores_all[:, np.flatnonzero(valid_mask)]
        profile_df = pd.DataFrame(profile_rows)
        if not profile_df.empty:
            valid_keys = observed_results[["kd_gene", "lr_type", "lr_name", "interaction_id"]].drop_duplicates()
            profile_df = profile_df.merge(valid_keys, on=["kd_gene", "lr_type", "lr_name", "interaction_id"], how="inner")

        eligible_eb_df = pd.DataFrame(eligible_eb_rows)
        eligible_eb_path = null_dir / safe_name(f"{kd_gene}__eligible_ebs.csv")
        eligible_eb_df.to_csv(eligible_eb_path, index=False)

        unit_label = f"{kd_gene}__dataset_level__{config.mode_name}"
        test_map_path = null_dir / safe_name(f"{unit_label}_test_map.csv")
        observed_results[["kd_gene", "lr_type", "lr_name", "interaction_id", "rho_distance"]].to_csv(
            test_map_path, index=False
        )

        state = initialize_permutation_state(observed_results, dense_scores_all, null_dir, unit_label)
        for chunk_start in range(0, n_permutations(config), null_chunk_size(config)):
            chunk_stop = min(chunk_start + null_chunk_size(config), n_permutations(config))
            chunk_width = chunk_stop - chunk_start
            chunk_null_rhos = (
                np.full((len(observed_results), chunk_width), np.nan, dtype=np.float32)
                if save_full_nulls(config) else None
            )

            for permutation_index in range(chunk_start, chunk_stop):
                perm_rng = np.random.default_rng(
                    stable_seed(SEED, kd_gene, config.mode_name, permutation_index, "global_spatial_shuffle")
                )
                perm_order = perm_rng.permutation(len(cell_ids_all))
                perm_guide_strings = guide_strings_all[perm_order]
                perm_kd_global = np.fromiter(
                    (guide_has_gene(label, kd_gene) for label in perm_guide_strings),
                    dtype=bool,
                    count=len(perm_guide_strings),
                )

                perm_receiver_positions: List[np.ndarray] = []
                perm_distance_chunks: List[np.ndarray] = []
                for eb_key, eb_idx in eb_indices_map.items():
                    perm_kd_mask = perm_kd_global[eb_idx]
                    n_kd = int(perm_kd_mask.sum())
                    n_non_kd = int((~perm_kd_mask).sum())
                    if n_kd < MIN_KD_CELLS_PER_EB or n_non_kd < MIN_RECEIVERS:
                        continue
                    perm_dist_all = nearest_reference_distances_from_matrix(
                        eb_distance_matrices[eb_key], np.flatnonzero(perm_kd_mask)
                    )
                    perm_receiver_mask = (~perm_kd_mask) & np.isfinite(perm_dist_all) & (perm_dist_all <= MAX_DISTANCE)
                    if int(perm_receiver_mask.sum()) < MIN_RECEIVERS:
                        continue
                    perm_receiver_positions.append(eb_idx[perm_receiver_mask])
                    perm_distance_chunks.append(perm_dist_all[perm_receiver_mask].astype(np.float64, copy=False))

                if not perm_receiver_positions:
                    continue

                receiver_positions = np.concatenate(perm_receiver_positions)
                perm_dist = np.concatenate(perm_distance_chunks)
                if perm_dist.size < MIN_RECEIVERS:
                    continue

                ranked_x, scale_x = centered_rank_vector(perm_dist)
                if not np.isfinite(scale_x) or scale_x == 0.0:
                    continue

                update_state_for_permutation(
                    state=state,
                    score_index=perm_order[receiver_positions],
                    ranked_x=ranked_x,
                    scale_x=scale_x,
                    chunk_column=permutation_index - chunk_start,
                    chunk_null_rhos=chunk_null_rhos,
                )
                if (permutation_index + 1) % 100 == 0:
                    print(f"  permutation {permutation_index + 1:,}/{n_permutations(config):,}")

            flush_null_chunk(
                state=state,
                unit_label=unit_label,
                chunk_start=chunk_start,
                chunk_stop=chunk_stop,
                chunk_null_rhos=chunk_null_rhos,
            )
            gc.collect()

        permutation_results = finalize_permutation_state(state)
        observed_results["p_positive_one_sided"] = permutation_results["p_positive"]
        observed_results["p_negative_one_sided"] = permutation_results["p_negative"]
        observed_results["n_permutations_positive_tail"] = permutation_results["positive_tail_counts"]
        observed_results["n_permutations_negative_tail"] = permutation_results["negative_tail_counts"]
        observed_results["n_valid_permutations"] = permutation_results["valid_counts"]
        observed_results["null_rho_file"] = permutation_results["manifest_path"]
        observed_results["null_rho_chunk_dir"] = permutation_results["chunk_dir"]
        observed_results["null_test_map_file"] = str(test_map_path)
        observed_results["eligible_eb_summary_file"] = str(eligible_eb_path)
        observed_results["full_null_rho_array_shape"] = f"{len(observed_results)}x{n_permutations(config)}"
        observed_results["full_null_rho_dtype"] = "float32"
        observed_results["null_chunk_size_permutations"] = null_chunk_size(config)

        observed_results.to_csv(
            result_dir / f"{safe_name(kd_gene)}_dataset_level_{config.mode_name}_KD_LR_results_RAW.csv",
            index=False,
        )
        if not profile_df.empty:
            profile_df.to_csv(
                profile_dir / f"{safe_name(kd_gene)}_dataset_level_{config.mode_name}_KD_LR_bin_profiles_RAW.csv",
                index=False,
            )
        gc.collect()

    if mode == "full":
        run_aggregate_only()


