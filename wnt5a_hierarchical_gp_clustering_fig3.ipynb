import argparse,gc
from pathlib import Path
import h5py
import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
import GPy
import GPclust
from scipy import linalg
from scipy.sparse import csr_matrix,csc_matrix
from scipy.spatial import KDTree
from scipy.stats import chi2
TARGET="WNT5A"
MAX_DISTANCE=300
BIN_WIDTH=10
RBF_STARTS=(10.,50.,200.)
MAX_OPT_ITERS=1000
FDR_THRESHOLD=0.05
CLUSTERS=4
RESTART_SEEDS=range(1,11)
def read_sparse(group):
    data=group["data"][:]
    indices=group["indices"][:]
    indptr=group["indptr"][:]
    shape=tuple(group.attrs["shape"])
    encoding=group.attrs.get("encoding-type",b"csr_matrix")
    if isinstance(encoding,bytes): encoding=encoding.decode()
    cls=csc_matrix if "csc" in encoding else csr_matrix
    return cls((data,indices,indptr),shape=shape)
def read_categorical(group):
    if isinstance(group,h5py.Dataset):
        return np.array([x.decode() if isinstance(x,bytes) else x for x in group[:]])
    categories=np.array([x.decode() if isinstance(x,bytes) else x for x in group["categories"][:]])
    return categories[group["codes"][:]]
def load_data(path):
    with h5py.File(path,"r") as f:
        return {
            "target":read_categorical(f["obs"]["target_call"]),
            "eb":read_categorical(f["obs"]["EB_manual_clustering"]),
            "spatial":np.column_stack([np.asarray(f["obs"]["SPATIAL_1"][:],float),np.asarray(f["obs"]["SPATIAL_2"][:],float)]),
            "rna":read_sparse(f["mod"]["rna"]["layers"]["log1p_normalized"]),
            "genes":np.array([x.decode() if isinstance(x,bytes) else x for x in f["mod"]["rna"]["var"]["_index"][:]])
        }
def bh(p):
    p=np.asarray(p,float)
    order=np.argsort(p,kind="stable")
    ranked=p[order]
    q=np.minimum.accumulate((ranked*len(p)/np.arange(1,len(p)+1))[::-1])[::-1]
    out=np.empty_like(q)
    out[order]=np.clip(q,0,1)
    return out
def prepare_profiles(raw):
    target,eb,xy,rna,genes=raw["target"],raw["eb"],raw["spatial"],raw["rna"],raw["genes"]
    excluded={"Unassigned","No_CRISPR_data","Non-Targeting"}
    kd=target==TARGET
    query=np.array([x not in excluded and x!=TARGET for x in target])
    dist=np.full(len(target),np.inf)
    for e in np.unique(eb):
        ref=(eb==e)&kd
        qry=(eb==e)&query
        if ref.sum()==0 or qry.sum()==0: continue
        d,_=KDTree(xy[ref]).query(xy[qry])
        dist[np.flatnonzero(qry)]=d
    valid=query&(dist<=MAX_DISTANCE)
    edges=np.arange(0,MAX_DISTANCE+BIN_WIDTH,BIN_WIDTH)
    mids=(edges[:-1]+edges[1:])/2
    cells=[]
    for i,(lo,hi) in enumerate(zip(edges[:-1],edges[1:])):
        upper=dist<=hi if i==len(edges)-2 else dist<hi
        cells.append(np.flatnonzero(valid&(dist>=lo)&upper))
    counts=np.array([len(x) for x in cells])
    if np.any(counts==0): raise ValueError(f"Empty distance bin(s): {counts}")
    eligible=np.concatenate(cells)
    detection=np.asarray((rna[eligible]!=0).mean(axis=0)).ravel()
    idx=np.flatnonzero(detection>0.05)
    means=np.empty((len(idx),len(cells)))
    sems=np.empty_like(means)
    for b,ids in enumerate(cells):
        x=rna[ids][:,idx].toarray()
        means[:,b]=x.mean(axis=0)
        sems[:,b]=x.std(axis=0,ddof=0)/np.sqrt(len(ids))
    return mids[:,None],means,sems,genes[idx],idx,counts
def scalar(x):
    return float(np.asarray(x,float).reshape(-1)[0])
def fit_gp(x,y,noise,kind,start=None):
    variance=max(float(np.mean(y**2)),float(noise),1e-12)
    if kind=="constant":
        kernel=GPy.kern.Bias(1,variance=variance)
    else:
        kernel=GPy.kern.RBF(1,variance=variance,lengthscale=float(start))
    model=GPy.models.GPRegression(np.asarray(x,float),np.asarray(y,float)[:,None],kernel=kernel,noise_var=float(noise),normalizer=False)
    model.Gaussian_noise.variance.fix(float(noise))
    model.optimize(optimizer="lbfgsb",messages=False,max_iters=MAX_OPT_ITERS)
    return float(model.log_likelihood())
def spatial_screen(x,means,sems,genes):
    rows=[]
    noise=np.mean(sems**2,axis=1)
    for i,gene in enumerate(genes):
        try:
            ll0=fit_gp(x,means[i],noise[i],"constant")
            fits=[fit_gp(x,means[i],noise[i],"rbf",s) for s in RBF_STARTS]
            ll1=max(fits)
            lrt=max(0.,2*(ll1-ll0))
            p=.5*chi2.sf(lrt,1) if lrt>0 else 1.
            rows.append([gene,i,ll0,ll1,lrt,p])
        except Exception as e:
            print(f"WARNING: {gene}: {e}")
            rows.append([gene,i,np.nan,np.nan,0.,1.])
        if (i+1)%500==0 or i+1==len(genes): print(f"Screened {i+1:,}/{len(genes):,} genes")
    df=pd.DataFrame(rows,columns=["gene","position","constant_loglik","rbf_loglik","lrt","p_value"])
    df["fdr_q_value"]=bh(df["p_value"])
    df["significant_fdr"]=df["fdr_q_value"]<=FDR_THRESHOLD
    return df
def fast_multiple_mahalanobis(X1,X2,L):
    left=linalg.solve_triangular(L,np.asarray(X1,float).T,lower=True,check_finite=False).T
    right=linalg.solve_triangular(L,np.asarray(X2,float).T,lower=True,check_finite=False).T
    d=np.einsum("ij,ij->i",left,left)[:,None]+np.einsum("ij,ij->i",right,right)[None,:]-2*left@right.T
    np.maximum(d,0,out=d)
    return d
def fit_cluster_restart(x,y,fixed_white,seed):
    np.random.seed(seed)
    kf=GPy.kern.RBF(1,variance=1.,lengthscale=50.)
    ky=GPy.kern.RBF(1,variance=.1,lengthscale=50.)
    wn=GPy.kern.White(1,variance=fixed_white)
    wn.variance.fix(fixed_white)
    model=GPclust.MOHGP(x,kf,ky+wn,y,K=CLUSTERS,prior_Z="symmetric",alpha=1.)
    model.hyperparam_opt_args["messages"]=False
    model.optimize(verbose=False)
    phi=np.asarray(model.phi,float)
    if phi.shape==(CLUSTERS,y.shape[0]): phi=phi.T
    muk=np.asarray(model.muk,float)
    if muk.shape==(CLUSTERS,x.shape[0]): muk=muk.T
    result={"seed":seed,"bound":float(model.bound()),"phi":phi.copy(),"means":muk.copy()}
    del model
    gc.collect()
    return result
def main(input_file,output_dir):
    out=Path(output_dir)
    out.mkdir(parents=True,exist_ok=True)
    print("Loading multiome data...")
    raw=load_data(input_file)
    x,means,sems,genes,gene_idx,bin_counts=prepare_profiles(raw)
    print(f"Testing {len(genes):,} genes across {len(x)} distance bins")
    screen=spatial_screen(x,means,sems,genes)
    screen.to_csv(out/"wnt5a_spatial_gp_screen.tsv",sep="\t",index=False)
    selected=np.flatnonzero(screen["significant_fdr"].to_numpy())
    print(f"BH FDR <= 0.05: {len(selected):,}/{len(genes):,} genes")
    selected_genes=genes[selected]
    selected_mean=means[selected]
    selected_sem=sems[selected]
    global_mean_sem=float(selected_sem.mean())
    fixed_white=float(global_mean_sem**2)
    weights=1./(selected_sem**2+fixed_white)
    weights/=weights.sum(axis=1,keepdims=True)
    centers=np.sum(weights*selected_mean,axis=1)
    y=selected_mean-centers[:,None]
    import GPclust.MOHGP as mohgp
    mohgp.multiple_mahalanobis=fast_multiple_mahalanobis
    fits=[]
    for seed in RESTART_SEEDS:
        print(f"GPClust restart {seed}/10")
        fits.append(fit_cluster_restart(x,y,fixed_white,seed))
    best=max(fits,key=lambda z:z["bound"])
    phi=best["phi"]
    cluster_means=best["means"]
    cluster_id=phi.argmax(axis=1)
    assignment_prob=phi.max(axis=1)
    assignments=pd.DataFrame({"gene":selected_genes,"original_gene_index":gene_idx[selected],"cluster":cluster_id,"assignment_probability":assignment_prob})
    assignments.to_csv(out/"wnt5a_gpclust_gene_assignments.tsv",sep="\t",index=False)
    print(f"Best seed: {best['seed']}; bound: {best['bound']:.6f}; cluster counts: {np.bincount(cluster_id,minlength=CLUSTERS).tolist()}")
    rng=np.random.default_rng(20260723)
    fig,axes=plt.subplots(2,2,figsize=(13,9),sharex=True)
    colors=plt.colormaps["tab10"](np.arange(CLUSTERS))
    for c,ax in enumerate(axes.ravel()):
        members=np.flatnonzero(cluster_id==c)
        shown=rng.choice(members,size=100,replace=False) if len(members)>100 else members
        ax.plot(x[:,0],y[shown].T,color=colors[c],alpha=.12,linewidth=.8)
        ax.plot(x[:,0],cluster_means[:,c],color=colors[c],linewidth=3,label="GP cluster trajectory")
        ax.axhline(0,color=".5",linewidth=.8,linestyle=":")
        ax.set_title(f"Cluster {c} (n={len(members)})")
        ax.set_ylabel("Expression relative to weighted gene baseline")
        ax.legend(frameon=False)
    for ax in axes[-1]: ax.set_xlabel("Distance to nearest WNT5A KD cell (µm)")
    fig.suptitle("WNT5A hierarchical GP clusters: centered spatial trajectories",fontsize=15)
    fig.tight_layout(rect=[0,0,1,.96])
    fig.savefig(out/"fig3e_wnt5a_gp_clusters.pdf",bbox_inches="tight")
    fig.savefig(out/"fig3e_wnt5a_gp_clusters.png",dpi=300,bbox_inches="tight")
    plt.close(fig)
if __name__=="__main__":
    p=argparse.ArgumentParser()
    p.add_argument("input_h5mu",help="Spatial multiome .h5mu file")
    p.add_argument("-o","--output",default="fig3e_wnt5a_gp_results")
    a=p.parse_args()
    main(a.input_h5mu,a.output)
