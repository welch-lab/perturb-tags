motif_hit_rows = []

for target in LIGAND_TARGETS:
    for direction, key in [
        ("increasing_with_distance", "chromvar_inc"),
        ("decreasing_with_distance", "chromvar_dec"),
    ]:
        for entry in dist_results[target][key]:
            motif_hit_rows.append(
                {
                    "target": target,
                    "motif": entry["motif"],
                    "direction": direction,
                    "rho": entry["rho"],
                    "delta": entry["delta"],
                }
            )

motif_hits_df = pd.DataFrame(motif_hit_rows)

fig, axes = plt.subplots(1, 2, figsize=(20, 14))

for ax, direction, title in [
    (
        axes[0],
        "increasing_with_distance",
        "Motif activity increases with distance",
    ),
    (
        axes[1],
        "decreasing_with_distance",
        "Motif activity decreases with distance",
    ),
]:
    subset = motif_hits_df[
        motif_hits_df["direction"] == direction
    ].copy()

    if subset.empty:
        ax.text(
            0.5,
            0.5,
            "No motifs passed",
            transform=ax.transAxes,
            ha="center",
            va="center",
        )
        ax.set_title(title)
        continue

    motif_target_counts = (
        subset.groupby("motif")["target"]
        .nunique()
        .sort_values(ascending=False)
    )

    recurrent_motifs = motif_target_counts[
        motif_target_counts >= 2
    ].index.tolist()[:30]

    if len(recurrent_motifs) == 0:
        ax.text(
            0.5,
            0.5,
            "No recurrent motifs in >=2 targets",
            transform=ax.transAxes,
            ha="center",
            va="center",
        )
        ax.set_title(title)
        continue

    presence_matrix = np.zeros(
        (len(recurrent_motifs), len(LIGAND_TARGETS)),
        dtype=int,
    )

    for motif_index, motif in enumerate(recurrent_motifs):
        targets_with_motif = subset.loc[
            subset["motif"] == motif,
            "target",
        ].unique()

        for target in targets_with_motif:
            if target in LIGAND_TARGETS:
                target_index = LIGAND_TARGETS.index(target)
                presence_matrix[motif_index, target_index] = 1

    ax.imshow(
        presence_matrix,
        aspect="auto",
        vmin=0,
        vmax=1,
    )

    for motif_index in range(len(recurrent_motifs)):
        for target_index in range(len(LIGAND_TARGETS)):
            if presence_matrix[motif_index, target_index] == 1:
                ax.plot(
                    target_index,
                    motif_index,
                    "o",
                    markersize=4,
                )

    ax.set_xticks(range(len(LIGAND_TARGETS)))
    ax.set_xticklabels(
        LIGAND_TARGETS,
        fontsize=7,
        rotation=45,
        ha="right",
    )

    ax.set_yticks(range(len(recurrent_motifs)))
    ax.set_yticklabels(
        recurrent_motifs,
        fontsize=7,
    )

    ax.set_title(
        f"{title}\n"
        f"Top recurrent motifs detected in at least 2 ligand KDs",
        fontsize=11,
        fontweight="bold",
    )

plt.suptitle(
    "Recurrent distance-dependent chromVAR motifs across ligand KDs",
    fontsize=14,
    y=1.01,
)

