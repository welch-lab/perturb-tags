# distance and motif tredn functions
def compute_distance_to_reference(
    spatial_coords,
    ref_mask,
    query_mask,
    eb_clusters,
    unique_ebs,
):
    """
    Compute each query cell's Euclidean distance to its nearest reference cell,
    separately within each EB.
    """
    distances = np.full(len(spatial_coords), np.inf, dtype=float)

    for eb in unique_ebs:
        eb_mask = eb_clusters == eb
        ref_in_eb = ref_mask & eb_mask
        query_in_eb = query_mask & eb_mask

        if ref_in_eb.sum() < 1 or query_in_eb.sum() < 1:
            continue

        ref_coords = spatial_coords[ref_in_eb]
        query_coords = spatial_coords[query_in_eb]

        tree = KDTree(ref_coords)
        dists, _ = tree.query(query_coords)

        distances[np.where(query_in_eb)[0]] = dists

    return distances


def build_distance_bins(distances, query_mask):
    """Return original cell indices assigned to each configured distance bin."""
    cell_indices_per_bin = {}

    for bin_idx, (lo, hi) in enumerate(DISTANCE_BINS):
        if bin_idx == len(DISTANCE_BINS) - 1:
            mask = query_mask & (distances >= lo) & (distances <= hi)
        else:
            mask = query_mask & (distances >= lo) & (distances < hi)

        cell_indices_per_bin[bin_idx] = np.where(mask)[0]

    return cell_indices_per_bin


def matrix_column_means(matrix, row_indices):
    """Calculate feature means for selected rows from dense or sparse matrices."""
    if len(row_indices) == 0:
        return np.array([], dtype=float)

    if issparse(matrix):
        return np.asarray(matrix[row_indices].mean(axis=0)).ravel()

    return np.asarray(matrix[row_indices], dtype=float).mean(axis=0)


def find_monotonic_motifs(
    matrix,
    cell_indices_per_bin,
    feature_names,
    direction,
    min_rho=MIN_RHO,
    min_abs_delta=MIN_ABS_DELTA,
    min_cells_per_bin=MIN_CELLS_PER_BIN,
):
    """
    Identify chromVAR motifs with distance-dependent activity.

    Parameters
    ----------
    direction
        "inc": motif activity increases as distance increases.
        "dec": motif activity decreases as distance increases.

    Selection criteria
    ------------------
    1. Every distance bin contains at least min_cells_per_bin cells.
    2. Spearman rho across ordered bins is >= min_rho for "inc".
    3. Spearman rho across ordered bins is <= -min_rho for "dec".
    4. Endpoint activity difference has the expected sign and magnitude.

    chromVAR values are signed. Therefore:
        delta = last-bin mean - first-bin mean
    is used instead of a fold-change ratio.
    """
    n_bins = len(cell_indices_per_bin)

    for bin_idx in range(n_bins):
        n_bin = len(cell_indices_per_bin[bin_idx])
        if n_bin < min_cells_per_bin:
            return []

    profiles = np.zeros((matrix.shape[1], n_bins), dtype=float)

    for bin_idx in range(n_bins):
        bin_cells = cell_indices_per_bin[bin_idx]
        profiles[:, bin_idx] = matrix_column_means(matrix, bin_cells)

    results = []
    bin_order = np.arange(n_bins, dtype=float)

    for feature_idx, feature_name in enumerate(feature_names):
        values = profiles[feature_idx]

        if not np.isfinite(values).all():
            continue

        # Constant profiles do not have a meaningful distance trend
        if np.allclose(values, values[0]):
            continue

        rho, pvalue = spearmanr(bin_order, values)

        if not np.isfinite(rho):
            continue

        delta = float(values[-1] - values[0])

        if direction == "inc":
            if rho < min_rho:
                continue
            if delta < min_abs_delta:
                continue

        elif direction == "dec":
            if rho > -min_rho:
                continue
            if delta > -min_abs_delta:
                continue

        else:
            raise ValueError("direction must be either 'inc' or 'dec'.")

        results.append(
            {
                "motif": str(feature_name),
                "covs": values.tolist(),
                "rho": float(rho),
                "pvalue": float(pvalue),
                "delta": delta,
                "abs_delta": abs(delta),
            }
        )

    results.sort(key=lambda x: (-abs(x["rho"]), -x["abs_delta"]))
    return results


def flatten_results(result_dictionary, analysis_type):
    """Convert nested KD/NTC motif results into a long table."""
    rows = []

    for reference_name, result in result_dictionary.items():
        for direction_label, result_key in [
            ("increasing_with_distance", "chromvar_inc"),
            ("decreasing_with_distance", "chromvar_dec"),
        ]:
            for rank, entry in enumerate(result.get(result_key, []), start=1):
                row = {
                    "analysis_type": analysis_type,
                    "reference": reference_name,
                    "direction": direction_label,
                    "rank": rank,
                    "motif": entry["motif"],
                    "rho": entry["rho"],
                    "pvalue": entry["pvalue"],
                    "delta_250_300_minus_0_50": entry["delta"],
                    "abs_delta": entry["abs_delta"],
                }

                for bin_label, value in zip(BIN_LABELS, entry["covs"]):
                    row[f"mean_activity_{bin_label}um"] = value

                rows.append(row)

    return pd.DataFrame(rows)

