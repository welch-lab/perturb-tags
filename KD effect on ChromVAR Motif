def decode_array(values):
    """Decode an HDF5 byte/string array into a NumPy string array."""
    return np.array(
        [value.decode() if isinstance(value, bytes) else str(value) for value in values],
        dtype=object,
    )


def read_categorical(group_or_dataset):
    """
    Read an AnnData/MuData categorical encoded as:
        categories + codes
    or read a plain dataset.
    """
    if isinstance(group_or_dataset, h5py.Dataset):
        return decode_array(group_or_dataset[:])

    if "categories" not in group_or_dataset or "codes" not in group_or_dataset:
        raise KeyError(
            "Expected a categorical group containing 'categories' and 'codes'."
        )

    categories = decode_array(group_or_dataset["categories"][:])
    codes = group_or_dataset["codes"][:]

    output = np.empty(len(codes), dtype=object)
    output[:] = ""

    valid = codes >= 0
    output[valid] = categories[codes[valid]]
    return output


def read_nullable_string(group_or_dataset):
    """Read nullable/string arrays stored in common AnnData HDF5 encodings."""
    if isinstance(group_or_dataset, h5py.Dataset):
        return decode_array(group_or_dataset[:])

    if "values" in group_or_dataset:
        values = decode_array(group_or_dataset["values"][:])
        if "mask" in group_or_dataset:
            mask = np.asarray(group_or_dataset["mask"][:], dtype=bool)
            values[mask] = ""
        return values

    if "categories" in group_or_dataset and "codes" in group_or_dataset:
        return read_categorical(group_or_dataset)

    raise KeyError("Unsupported nullable/string HDF5 encoding.")


def read_sparse_matrix(group):
    """Read CSR/CSC sparse matrices from an AnnData/MuData HDF5 group."""
    data = group["data"][:]
    indices = group["indices"][:]
    indptr = group["indptr"][:]

    if "shape" in group.attrs:
        shape = tuple(int(x) for x in group.attrs["shape"])
    else:
        shape = (
            len(indptr) - 1,
            int(indices.max()) + 1 if len(indices) > 0 else 0,
        )

    encoding = group.attrs.get("encoding-type", b"csr_matrix")
    if isinstance(encoding, bytes):
        encoding = encoding.decode()

    if "csc" in str(encoding).lower():
        return csc_matrix((data, indices, indptr), shape=shape)

    return csr_matrix((data, indices, indptr), shape=shape)


def read_matrix(group_or_dataset):
    """Read either a dense HDF5 dataset or a sparse HDF5 matrix group."""
    if isinstance(group_or_dataset, h5py.Dataset):
        return np.asarray(group_or_dataset[:])

    required = {"data", "indices", "indptr"}
    if required.issubset(group_or_dataset.keys()):
        return read_sparse_matrix(group_or_dataset)

    raise TypeError("Unsupported matrix encoding.")


def read_obs_column(obs_group, column_name):
    """Read one obs column regardless of categorical or plain encoding."""
    if column_name not in obs_group:
        raise KeyError(f"Missing required obs column: {column_name}")
    return read_categorical(obs_group[column_name])


def read_numeric_obs_column(obs_group, column_name):
    """Read one numeric obs column."""
    if column_name not in obs_group:
        raise KeyError(f"Missing required obs column: {column_name}")

    obj = obs_group[column_name]

    if isinstance(obj, h5py.Dataset):
        return np.asarray(obj[:], dtype=float)

    # Some numeric columns represented categorically
    if "categories" in obj and "codes" in obj:
        return read_categorical(obj).astype(float)

    if "values" in obj:
        values = np.asarray(obj["values"][:], dtype=float)
        if "mask" in obj:
            mask = np.asarray(obj["mask"][:], dtype=bool)
            values[mask] = np.nan
        return values

    raise TypeError(f"Unsupported encoding for numeric obs column: {column_name}")


